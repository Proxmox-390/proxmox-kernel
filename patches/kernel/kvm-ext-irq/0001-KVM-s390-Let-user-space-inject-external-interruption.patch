diff --git a/arch/s390/kvm/s390/interrupt.c b/arch/s390/kvm/s390/interrupt.c
index f5535a6cd4c1..f06ef5de3376 100644
--- a/arch/s390/kvm/s390/interrupt.c
+++ b/arch/s390/kvm/s390/interrupt.c
@@ -346,6 +346,9 @@ static unsigned long deliverable_irqs(struct kvm_vcpu *vcpu)
 		__clear_bit(IRQ_PEND_EXT_SERVICE, &active_mask);
 		__clear_bit(IRQ_PEND_EXT_SERVICE_EV, &active_mask);
 	}
+	if (!(vcpu->arch.sie_block->gcr[0] &
+	      READ_ONCE(vcpu->arch.local_int.irq.ext_user.subclass)))
+		__clear_bit(IRQ_PEND_EXT_USER, &active_mask);
 	if (psw_mchk_disabled(vcpu))
 		active_mask &= ~IRQ_PEND_MCHK_MASK;
 	/* PV guest cpus can have a single interruption injected at a time. */
@@ -926,6 +929,37 @@ static int __must_check __deliver_external_call(struct kvm_vcpu *vcpu)
 	return rc ? -EFAULT : 0;
 }
 
+static int __must_check __deliver_ext_user(struct kvm_vcpu *vcpu)
+{
+	struct kvm_s390_local_interrupt *li = &vcpu->arch.local_int;
+	struct kvm_s390_ext_user_info ext;
+	int rc;
+
+	spin_lock(&li->lock);
+	ext = li->irq.ext_user;
+	memset(&li->irq.ext_user, 0, sizeof(li->irq.ext_user));
+	clear_bit(IRQ_PEND_EXT_USER, &li->pending_irqs);
+	spin_unlock(&li->lock);
+
+	VCPU_EVENT(vcpu, 4, "deliver: user external 0x%x", ext.code);
+	vcpu->stat.deliver_ext_user++;
+	trace_kvm_s390_deliver_interrupt(vcpu->vcpu_id, KVM_S390_INT_EXT_USER,
+					 ext.code, ext.params);
+
+	rc = put_guest_lc(vcpu, ext.code, (u16 *)__LC_EXT_INT_CODE);
+	if (ext.flags & KVM_S390_EXT_USER_CPU_ADDR)
+		rc |= put_guest_lc(vcpu, ext.cpu_addr, (u16 *)__LC_EXT_CPU_ADDR);
+	if (ext.flags & KVM_S390_EXT_USER_PARAMS)
+		rc |= put_guest_lc(vcpu, ext.params, (u32 *)__LC_EXT_PARAMS);
+	/* ESA/390 has no second parameter */
+	if ((ext.flags & KVM_S390_EXT_USER_PARAMS2) &&
+	    !kvm_s390_vcpu_is_esa(vcpu))
+		rc |= put_guest_lc(vcpu, ext.params2, (u64 *)__LC_EXT_PARAMS2);
+	rc |= kvm_s390_lc_store_old_psw(vcpu, __LC_EXT_OLD_PSW);
+	rc |= kvm_s390_lc_load_new_psw(vcpu, __LC_EXT_NEW_PSW);
+	return rc ? -EFAULT : 0;
+}
+
 static int __deliver_prog_pv(struct kvm_vcpu *vcpu, u16 code)
 {
 	switch (code) {
@@ -1636,6 +1670,9 @@ int __must_check kvm_s390_deliver_pending_interrupts(struct kvm_vcpu *vcpu)
 		case IRQ_PEND_VIRTIO:
 			rc = __deliver_virtio(vcpu);
 			break;
+		case IRQ_PEND_EXT_USER:
+			rc = __deliver_ext_user(vcpu);
+			break;
 		default:
 			WARN_ONCE(1, "Unknown pending irq type %ld", irq_type);
 			clear_bit(irq_type, &li->pending_irqs);
@@ -2315,6 +2352,34 @@ void kvm_s390_clear_stop_irq(struct kvm_vcpu *vcpu)
 	spin_unlock(&li->lock);
 }
 
+#define KVM_S390_EXT_USER_FLAGS (KVM_S390_EXT_USER_CPU_ADDR | \
+				 KVM_S390_EXT_USER_PARAMS | \
+				 KVM_S390_EXT_USER_PARAMS2)
+
+static int __inject_ext_user(struct kvm_vcpu *vcpu, struct kvm_s390_irq *irq)
+{
+	struct kvm_s390_local_interrupt *li = &vcpu->arch.local_int;
+	struct kvm_s390_ext_user_info *ext = &irq->u.ext_user;
+	u64 subclass = READ_ONCE(vcpu->kvm->arch.user_ext_subclass);
+
+	if (!ext->subclass || ext->subclass & ~subclass ||
+	    ext->flags & ~KVM_S390_EXT_USER_FLAGS || ext->reserved ||
+	    kvm_s390_pv_cpu_get_handle(vcpu))
+		return -EINVAL;
+	if (test_bit(IRQ_PEND_EXT_USER, &li->pending_irqs))
+		return -EBUSY;
+
+	vcpu->stat.inject_ext_user++;
+	VCPU_EVENT(vcpu, 3, "inject: user external 0x%x", ext->code);
+	trace_kvm_s390_inject_vcpu(vcpu->vcpu_id, KVM_S390_INT_EXT_USER,
+				   ext->code, ext->params);
+
+	li->irq.ext_user = *ext;
+	set_bit(IRQ_PEND_EXT_USER, &li->pending_irqs);
+	kvm_s390_set_cpuflags(vcpu, CPUSTAT_EXT_INT);
+	return 0;
+}
+
 static int do_inject_vcpu(struct kvm_vcpu *vcpu, struct kvm_s390_irq *irq, bool *storestatus)
 {
 	int rc;
@@ -2350,6 +2415,9 @@ static int do_inject_vcpu(struct kvm_vcpu *vcpu, struct kvm_s390_irq *irq, bool
 	case KVM_S390_INT_PFAULT_INIT:
 		rc = __inject_pfault_init(vcpu, irq);
 		break;
+	case KVM_S390_INT_EXT_USER:
+		rc = __inject_ext_user(vcpu, irq);
+		break;
 	case KVM_S390_INT_VIRTIO:
 	case KVM_S390_INT_SERVICE:
 	case KVM_S390_INT_IO_MIN...KVM_S390_INT_IO_MAX:
@@ -3483,6 +3551,10 @@ static void store_local_irq(struct kvm_s390_local_interrupt *li,
 	case IRQ_PEND_RESTART:
 		irq->type = KVM_S390_RESTART;
 		break;
+	case IRQ_PEND_EXT_USER:
+		irq->type = KVM_S390_INT_EXT_USER;
+		irq->u.ext_user = li->irq.ext_user;
+		break;
 	case IRQ_PEND_SET_PREFIX:
 		irq->type = KVM_S390_SIGP_SET_PREFIX;
 		irq->u.prefix = li->irq.prefix;
