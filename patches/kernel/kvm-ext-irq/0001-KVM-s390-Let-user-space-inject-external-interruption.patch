 	STATS_DESC_COUNTER(VCPU, deliver_virtio),
+	STATS_DESC_COUNTER(VCPU, deliver_ext_user),
 	STATS_DESC_COUNTER(VCPU, deliver_stop_signal),
 	STATS_DESC_COUNTER(VCPU, deliver_prefix_signal),
 	STATS_DESC_COUNTER(VCPU, deliver_restart_signal),
@@ -133,6 +134,7 @@ const struct kvm_stats_desc kvm_vcpu_stats_desc[] = {
 	STATS_DESC_COUNTER(VCPU, inject_ckc),
 	STATS_DESC_COUNTER(VCPU, inject_cputm),
 	STATS_DESC_COUNTER(VCPU, inject_external_call),
+	STATS_DESC_COUNTER(VCPU, inject_ext_user),
 	STATS_DESC_COUNTER(VCPU, inject_emergency_signal),
 	STATS_DESC_COUNTER(VCPU, inject_mchk),
 	STATS_DESC_COUNTER(VCPU, inject_pfault_init),
@@ -726,6 +728,9 @@ int kvm_vm_ioctl_check_extension(struct kvm *kvm, long ext)
 	case KVM_CAP_S390_CPU_TOPOLOGY:
 		r = test_facility(11);
 		break;
+	case KVM_CAP_S390_USER_EXT_IRQ:
+		r = !(kvm && kvm_is_ucontrol(kvm));
+		break;
 	case KVM_CAP_S390_ESA390_CM:
 		/*
 		 * Like KVM_CAP_S390_VSIE_ESAMODE, this relies on SIE accepting
@@ -966,6 +971,17 @@ int kvm_vm_ioctl_enable_cap(struct kvm *kvm, struct kvm_enable_cap *cap)
 		VM_EVENT(kvm, 3, "ENABLE: CAP_S390_ESA390_CM %s",
 			 r ? "(not available)" : "(success)");
 		break;
+	case KVM_CAP_S390_USER_EXT_IRQ:
+		if (kvm_is_ucontrol(kvm) || !cap->args[0] || cap->args[1] ||
+		    cap->args[2] || cap->args[3]) {
+			r = -EINVAL;
+		} else {
+			WRITE_ONCE(kvm->arch.user_ext_subclass, cap->args[0]);
+			r = 0;
+		}
+		VM_EVENT(kvm, 3, "ENABLE: CAP_S390_USER_EXT_IRQ 0x%llx %s",
+			 cap->args[0], r ? "(not available)" : "(success)");
+		break;
 	default:
 		r = -EINVAL;
 		break;
