+/* two CPUs with different prefixes read their own low storage at virtual 0 */
+struct prefix_arg {
+	struct kvm_vcpu *vcpu;
+	u32 expect;
+	int bad;
+};
+
+static void *prefix_thread(void *data)
+{
+	struct prefix_arg *a = data;
+	int i;
+
+	for (i = 0; i < 2000; i++) {
+		if (run(a->vcpu, gaddr(g_load), true, 0x200, 0, 0) != EXIT_DONE ||
+		    gpr(a->vcpu, 1) != a->expect)
+			a->bad++;
+	}
+	return NULL;
+}
+
+static void test_two_cpus(struct kvm_vcpu *vcpu0, struct kvm_vcpu *vcpu1)
+{
+	struct prefix_arg a0 = { vcpu0, 0x11111111 }, a1 = { vcpu1, 0x22222222 };
+	pthread_t t0, t1;
+
+	wr32(0x200, 0x11111111);
+	wr32(PREFIX1 + 0x200, 0x22222222);
+	pthread_create(&t0, NULL, prefix_thread, &a0);
+	pthread_create(&t1, NULL, prefix_thread, &a1);
+	pthread_join(t0, NULL);
+	pthread_join(t1, NULL);
+	ksft_test_result(!a0.bad && !a1.bad,
+			 "two vCPUs translated at the same time, each sees its prefix area (%d %d)\n",
+			 a0.bad, a1.bad);
+}
+
+/*
+ * vCPU 0 reads a virtual page in a loop; vCPU 1 changes its translation and
+ * then sets a flag. Once vCPU 0 sees the flag, it must see the change: an
+ * invalidation or purge on one CPU completes for all CPUs.
+ */
+struct reader_arg {
+	struct kvm_vcpu *vcpu;
+	const char *code;
+	int exit;
+};
+
+static void *reader_thread(void *data)
+{
+	struct reader_arg *a = data;
+	__u64 *g = a->vcpu->run->s.regs.gprs;
+
+	g[5] = 0x7fffffff;
+	g[6] = V_DATA;
+	g[7] = 0;
+	g[10] = 0xbbbbbbbb;
+	g[12] = FLAG;
+	g[13] = STD_PAIR;
+	a->exit = run(a->vcpu, gaddr(a->code), true, 0, 0, 0);
+	return NULL;
+}
+
+static void wait_reader(void)
+{
+	while (!rd32(FLAG + 8))
+		usleep(10);
+	usleep(200);
+}
+
+static void test_cross_ipte(struct kvm_vcpu *vcpu0, struct kvm_vcpu *vcpu1, bool sw)
+{
+	struct reader_arg a = { vcpu0, sw ? g_xswitch : g_xread };
+	int i, bad = 0;
+	pthread_t t;
+
+	for (i = 0; i < 200 && !bad; i++) {
+		wr32(PTO1 + 12, R_DATA_A);
+		wr32(FLAG, 0);
+		wr32(FLAG + 8, 0);
+		pthread_create(&t, NULL, reader_thread, &a);
+		wait_reader();
+		vcpu1->run->s.regs.gprs[6] = V_DATA;
+		vcpu1->run->s.regs.gprs[11] = PTO1;
+		vcpu1->run->s.regs.gprs[12] = FLAG;
+		if (run(vcpu1, gaddr(g_xipte), true, 0, 1, 0) != EXIT_DONE)
+			bad++;
+		pthread_join(t, NULL);
+		if (a.exit != EXIT_PGM || rd16(LC_PGM_CODE + 2) != 0x11 || gpr(vcpu0, 7))
+			bad++;
+	}
+	ksft_test_result(!bad,
+			 "IPTE on one vCPU invalidates the page for a vCPU reading it%s (%d rounds, exit %d code %x)\n",
+			 sw ? " in two spaces sharing the page table" : "",
+			 i, a.exit, rd16(LC_PGM_CODE + 2));
+	wr32(PTO1 + 12, R_DATA_A);
+	set_crs(vcpu0, CR0_DAT, STD);
+}
+
+static void test_cross_csp(struct kvm_vcpu *vcpu0, struct kvm_vcpu *vcpu1, bool sw)
+{
+	struct reader_arg a = { vcpu0, sw ? g_xswitch_new : g_xread_new };
+	__u64 *g = vcpu1->run->s.regs.gprs;
+	int i, bad = 0;
+	pthread_t t;
+
+	for (i = 0; i < 200 && !bad; i++) {
+		wr32(PTO1 + 12, R_DATA_A);
+		TEST_ASSERT_EQ(run(vcpu0, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+		TEST_ASSERT_EQ(run(vcpu1, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+		wr32(FLAG, 0);
+		wr32(FLAG + 8, 0);
+		wr32(CSP_WORD, 0);
+		pthread_create(&t, NULL, reader_thread, &a);
+		wait_reader();
+		g[0] = 0;
+		g[1] = 0;
+		g[12] = FLAG;
+		g[13] = CSP_WORD | 1;
+		if (run(vcpu1, gaddr(g_xcsp), true, PTO1 + 12, 1, R_DATA_B) != EXIT_DONE)
+			bad++;
+		pthread_join(t, NULL);
+		if (a.exit != EXIT_DONE || gpr(vcpu0, 7) || gpr(vcpu0, 1) != 0xbbbbbbbb)
+			bad++;
+	}
+	ksft_test_result(!bad,
+			 "CSP with purge on one vCPU purges for a vCPU reading the page%s (%d rounds, exit %d value %08x)\n",
+			 sw ? " in two spaces sharing the page table" : "",
+			 i, a.exit, gpr(vcpu0, 1));
+	set_crs(vcpu0, CR0_DAT, STD);
+	wr32(PTO1 + 12, R_DATA_A);
+	TEST_ASSERT_EQ(run(vcpu0, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+	TEST_ASSERT_EQ(run(vcpu1, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+}
+
+/*
+ * Prefixing swaps virtual page PREFIX2 into shadow segment 0, which has its
+ * page table from segment 0 already: IPTE of its entry must still reach it.
+ * Segment 1 uses a page table in a page of its own here, so that nothing
+ * else ties that page to the shadow.
+ */
+static void test_prefix_ipte(struct kvm_vcpu *vcpu0, struct kvm_vcpu *vcpu1)
+{
+	u32 pte = PTO1_ALT + 4 * ((PREFIX2 >> 12) & 0xff);
+	u16 code;
+	int n;
+
+	memcpy(mem + PTO1_ALT, mem + PTO1, 1024);
+	wr32(STO + 4, PTO1_ALT | 0xf);
+	setup_lowcore(PREFIX2);
+	wr32(pte, PREFIX2);
+	vcpu1->run->s.regs.prefix = PREFIX2;
+	vcpu1->run->kvm_dirty_regs |= KVM_SYNC_PREFIX;
+	wr32(0x200, 0x5a5a5a5a);
+	TEST_ASSERT_EQ(run(vcpu1, gaddr(g_load), true, 0x1200, 0, 0), EXIT_DONE);
+	n = run(vcpu1, gaddr(g_load), true, PREFIX2 + 0x200, 0, 0);
+	TEST_ASSERT(n == EXIT_DONE && gpr(vcpu1, 1) == 0x5a5a5a5a,
+		    "virtual prefix page reads absolute page 0 (%d %08x)", n, gpr(vcpu1, 1));
+	vcpu0->run->s.regs.gprs[6] = PREFIX2;
+	vcpu0->run->s.regs.gprs[11] = PTO1_ALT;
+	vcpu0->run->s.regs.gprs[12] = FLAG + 0x10;
+	TEST_ASSERT_EQ(run(vcpu0, gaddr(g_xipte), true, 0, 1, 0), EXIT_DONE);
+	n = run(vcpu1, gaddr(g_load), true, PREFIX2 + 0x200, 0, 0);
+	code = rd16(PREFIX2 + LC_PGM_CODE + 2);
+	ksft_test_result(n == EXIT_PGM && code == 0x11,
+			 "IPTE reaches the page that prefixing moved to another shadow segment (exit %d code %x)\n",
+			 n, code);
+	wr32(STO + 4, PTO1 | 0xf);
+	TEST_ASSERT_EQ(run(vcpu0, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+	vcpu1->run->s.regs.prefix = PREFIX1;
+	vcpu1->run->kvm_dirty_regs |= KVM_SYNC_PREFIX;
+	TEST_ASSERT_EQ(run(vcpu1, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+	memset(mem + PREFIX2, 0, 0x1000);
+}
