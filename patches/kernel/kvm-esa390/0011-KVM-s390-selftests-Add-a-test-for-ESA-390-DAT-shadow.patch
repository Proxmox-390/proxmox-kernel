+/* SIGP EMERGENCY SIGNAL from one vCPU interrupts a translated loop on another */
+static void *eloop_thread(void *data)
+{
+	struct kvm_vcpu *vcpu = data;
+	struct kvm_run *r = vcpu->run;
+
+	set_crs(vcpu, CR0_DAT | CR0_EMS, STD);
+	r->psw_mask = PSW_MASK_BA | PSW_MASK_DAT | PSW_MASK_EXT;
+	r->psw_addr = gaddr(g_eloop);
+	r->s.regs.gprs[12] = FLAG;
+	r->s.regs.gprs[5] = 1;
+	r->kvm_dirty_regs |= KVM_SYNC_GPRS;
+	vcpu_run(vcpu);
+	return NULL;
+}
+
+static void test_sigp_emergency(struct kvm_vcpu *vcpu0, struct kvm_vcpu *vcpu1)
+{
+	struct kvm_run *r = vcpu0->run;
+	pthread_t t;
+	int n;
+
+	wr32(FLAG + 8, 0);
+	alarm(20);
+	pthread_create(&t, NULL, eloop_thread, vcpu0);
+	wait_reader();
+	n = run(vcpu1, gaddr(g_sigp), true, 0, 0, 0);
+	pthread_join(t, NULL);
+	alarm(0);
+	ksft_test_result(n == EXIT_DONE && ((gpr(vcpu1, 3) >> 28) & 3) == 0 &&
+			 r->exit_reason == KVM_EXIT_S390_SIEIC &&
+			 ((r->s390_sieic.ipa >> 4) & 0xf) == EXIT_EXT &&
+			 rd16(LC_EXT_CODE) == 0x1201 && rd16(LC_EXT_CPU_ADDR) == 1 &&
+			 (rd32(ESA_EXT_OLD) & ESA_PSW_DAT),
+			 "SIGP emergency signal interrupts a translated vCPU (code %04x from %u, old psw %016lx)\n",
+			 rd16(LC_EXT_CODE), rd16(LC_EXT_CPU_ADDR), rd64(ESA_EXT_OLD));
+	set_crs(vcpu0, CR0_DAT, STD);
+}
