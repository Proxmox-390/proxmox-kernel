From ac0373ef4c5696c3ca5d4a79e7dcd0eacecb302a Mon Sep 17 00:00:00 2001
From: Yvan Janssens <yvanj@cyber.gent>
Date: Thu, 26 Nov 2026 11:05:16 +0100
Subject: [RFC PATCH 4/4] KVM: s390: selftests: Add a test for ESA/390 DAT
 shadowing

Check LOAD REAL ADDRESS with DAT off and on, translation, translation and
protection exceptions, the purges, the system-mask instructions, SVC and
LPSW, a clock-comparator interruption of a translated loop, a wait PSW with
an odd address loaded by LPSW, the home
space with SAC, SACF and IAC, the space-switch event, the refusal of the
secondary space, two vCPUs with different prefixes, IPTE and the CSP
purge on one vCPU seen by another one reading the page, also while it
switches between two spaces sharing the page table, IPTE of a page
prefixing moved, SIGP emergency signal to a translated vCPU, the bound on
the number of shadows, a guest page 0 that is not translated, also
when it becomes valid while its space is not in use, table
changes by the guest, that guest storage does not hold anything of the
shadow, and the switch to z/Architecture.
---
 tools/testing/selftests/kvm/Makefile.kvm      |    1 +
 .../selftests/kvm/s390/esa390_dat_test.c      | 1059 +++++++++++++++++
 2 files changed, 1060 insertions(+)
 create mode 100644 tools/testing/selftests/kvm/s390/esa390_dat_test.c

diff --git a/tools/testing/selftests/kvm/Makefile.kvm b/tools/testing/selftests/kvm/Makefile.kvm
index ff9f9740b904..9041acc15fea 100644
--- a/tools/testing/selftests/kvm/Makefile.kvm
+++ b/tools/testing/selftests/kvm/Makefile.kvm
@@ -222,6 +222,7 @@ TEST_GEN_PROGS_s390 += s390/user_operexec
 TEST_GEN_PROGS_s390 += s390/keyop
 TEST_GEN_PROGS_s390 += s390/vsie_esa_test
 TEST_GEN_PROGS_s390 += s390/esa390_cm_test
+TEST_GEN_PROGS_s390 += s390/esa390_dat_test
 TEST_GEN_PROGS_s390 += rseq_test
 TEST_GEN_PROGS_s390 += s390/irq_routing
 TEST_GEN_PROGS_s390 += mmu_stress_test
diff --git a/tools/testing/selftests/kvm/s390/esa390_dat_test.c b/tools/testing/selftests/kvm/s390/esa390_dat_test.c
new file mode 100644
index 000000000000..9c47b64b348e
--- /dev/null
+++ b/tools/testing/selftests/kvm/s390/esa390_dat_test.c
@@ -0,0 +1,1059 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Test ESA/390 DAT shadowing (KVM_CAP_S390_ESA390_CM, KVM_S390_ESA390_CM_DAT).
+ *
+ * The guest has ESA/390 segment and page tables in its storage. Small code
+ * fragments run with DAT off or on; the test checks LOAD REAL ADDRESS, the
+ * translation, translation and protection exceptions, the purges, the home
+ * space, prefixing on two CPUs, invalidation across CPUs, interruptions and
+ * the bound on the number of shadows.
+ */
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/ioctl.h>
+
+#include "kvm_util.h"
+#include "test_util.h"
+#include "kselftest.h"
+#include "sie.h"
+
+#define GUEST_MEM_PAGES		512		/* 2 MiB */
+#define GUEST_CODE		0x2000UL
+#define PREFIX1			0x8000UL
+#define PREFIX2			0x15e000UL	/* in segment 1 */
+#define FLAG			0x6000UL	/* flag, progress counter */
+#define CSP_WORD		0x6100UL
+
+/* tables: segment table, page tables of segments 0 and 1 */
+#define STO			0x10000UL
+#define PTO0			0x11000UL
+#define PTO1			0x11400UL
+#define STD			(STO | 0)	/* 16 segments */
+#define STO_HOME		0x12000UL	/* home space: V_DATA -> R_DATA_B */
+#define PTO1_HOME		0x12400UL
+#define PTO1_ALT		0x13000UL	/* own page, unlike PTO0/PTO1 */
+#define STO2			0x14000UL	/* second space sharing PTO0/PTO1 */
+#define STD_PAIR		0x6200UL	/* STD, STO2 for LCTL */
+#define PTO0_ALT		0x15000UL	/* segment 0 with page 0 changing */
+#define STO3			0x16000UL
+#define STD_HOME		(STO_HOME | 0)
+#define STD_SSE			0x80000000U	/* space-switch-event control */
+#define STO_MANY		0x80000UL	/* copies for the bound test */
+#define NR_MANY			80
+
+/* virtual pages in segment 1 and what they map */
+#define V_CODE			0x100000UL	/* -> R_CODE */
+#define V_INVALID		0x101000UL	/* page invalid */
+#define V_PROT			0x102000UL	/* -> R_PROT, page protection */
+#define V_DATA			0x103000UL	/* -> R_DATA_A or R_DATA_B */
+#define V_NOMEM			0x104000UL	/* -> outside the configuration */
+#define R_CODE			0x150000UL
+#define R_PROT			0x152000UL
+#define R_DATA_A		0x153000UL
+#define R_DATA_B		0x154000UL
+#define R_NOMEM			0x7ff00000UL
+#define V_SEG2			0x200000UL	/* segment invalid */
+#define V_SEG16			0x1000000UL	/* beyond the segment-table length */
+
+#define ESA_STE_I		0x20U
+#define ESA_PTE_I		0x400U
+#define ESA_PTE_P		0x200U
+
+#define CR0_DAT			0x00b00000U	/* translation format */
+#define CR0_CKC			0x00000800U
+#define CR0_EMS			0x00004000U
+#define CR0_SAC			0x04000000U	/* secondary-space control */
+#define ESA_PSW_HOME		0x0000c000U
+#define LC_EXT_CPU_ADDR		132
+
+#define ESA_PSW_BIT12		0x00080000U
+#define ESA_PSW_DAT		0x04000000U
+#define ESA_PSW_EXT		0x01000000U
+#define PSW_MASK_DAT		0x0400000000000000ULL
+#define PSW_MASK_EXT		0x0100000000000000ULL
+#define PSW_MASK_BA		0x0000000080000000ULL
+
+/* ESA/390 assigned storage locations */
+#define ESA_EXT_OLD		24
+#define ESA_SVC_OLD		32
+#define ESA_PGM_OLD		40
+#define ESA_EXT_NEW		88
+#define ESA_SVC_NEW		96
+#define ESA_PGM_NEW		104
+#define LC_EXT_CODE		134
+#define LC_SVC_CODE		136
+#define LC_PGM_CODE		140
+#define LC_TEID			144
+
+enum { EXIT_SVC = 1, EXIT_EXT, EXIT_PGM = 5, EXIT_DONE = 8, EXIT_DONE2 = 9 };
+
+extern char g_start[], g_end[], g_load[], g_store[], g_lra[], g_ptlb[], g_ipte[],
+	g_csp[], g_stress[], g_stnsm[], g_stnsm_off[], g_svc[], g_loop[], g_lpsw[],
+	g_xread[], g_xread_new[], g_xipte[], g_xcsp[], g_sigp[], g_eloop[],
+	g_home[], g_home_sacf[], g_sac_sec[], g_xswitch[], g_xswitch_new[],
+	s_svc[], s_ext[], s_pgm[], g_code_v[], g_code_v_st[], g_code_v_end[];
+
+asm("	.pushsection .rodata, \"a\"\n"
+	"	.balign	8\n"
+	"g_start:\n"
+	"g_load:	l	%r1,0(%r2)\n	diag	8,0,0x501\n"
+	"g_store:	st	%r3,0(%r2)\n	diag	8,0,0x501\n"
+	"g_lra:	lra	%r1,0(%r2)\n	ipm	%r3\n	diag	8,0,0x501\n"
+	"g_ptlb:	ptlb\n	diag	8,0,0x501\n"
+	"g_ipte:	ipte	%r4,%r2\n	diag	8,0,0x501\n"
+	"g_csp:	csp	%r4,%r2\n	ipm	%r3\n	diag	8,0,0x501\n"
+	"g_stnsm:	stnsm	0(%r2),0xff\n	diag	8,0,0x501\n"
+	"g_stnsm_off:	stnsm	0(%r2),0xfb\n	diag	9,0,0x501\n"
+	"g_svc:	svc	0x42\n"
+	"g_loop:	j	g_loop\n"
+	"g_lpsw:	lpsw	0(%r2)\n"
+    /* r2 PTE, r3/r4 entries A/B, r5 count, r6 va, r9/r10 values, r11 PTO, r7 errors */
+	"g_stress:	st	%r3,0(%r2)\n"
+	"	ptlb\n"
+	"	l	%r1,0(%r6)\n"
+	"	cr	%r1,%r9\n"
+	"	je	1f\n"
+	"	ahi	%r7,1\n"
+	"1:	ipte	%r11,%r6\n"
+	"	st	%r4,0(%r2)\n"
+	"	l	%r1,0(%r6)\n"
+	"	cr	%r1,%r10\n"
+	"	je	2f\n"
+	"	ahi	%r7,1\n"
+	"2:	brct	%r5,g_stress\n"
+	"	diag	8,0,0x501\n"
+    /* r5 count, r6 va, r7 errors, r10 new value, r12 FLAG: read until the flag is set */
+	"g_xread:	st	%r5,8(%r12)\n"
+	"	l	%r8,0(%r12)\n"
+	"	l	%r1,0(%r6)\n"
+	"	ltr	%r8,%r8\n"
+	"	jz	1f\n"
+	"	ahi	%r7,1\n"
+	"	diag	8,0,0x501\n"
+	"1:	brct	%r5,g_xread\n"
+	"	diag	9,0,0x501\n"
+    /* the same, switching between two spaces (r13: their STDs) */
+	"g_xswitch:	st	%r5,8(%r12)\n"
+	"	lctl	%c1,%c1,0(%r13)\n"
+	"	l	%r8,0(%r12)\n"
+	"	l	%r1,0(%r6)\n"
+	"	ltr	%r8,%r8\n"
+	"	jz	1f\n"
+	"	ahi	%r7,1\n"
+	"	diag	8,0,0x501\n"
+	"1:	lctl	%c1,%c1,4(%r13)\n"
+	"	l	%r8,0(%r12)\n"
+	"	l	%r1,0(%r6)\n"
+	"	ltr	%r8,%r8\n"
+	"	jz	2f\n"
+	"	ahi	%r7,1\n"
+	"	diag	8,0,0x501\n"
+	"2:	brct	%r5,g_xswitch\n"
+	"	diag	9,0,0x501\n"
+	"g_xswitch_new:	st	%r5,8(%r12)\n"
+	"	lctl	%c1,%c1,0(%r13)\n"
+	"	l	%r8,0(%r12)\n"
+	"	l	%r1,0(%r6)\n"
+	"	ltr	%r8,%r8\n"
+	"	jz	1f\n"
+	"	cr	%r1,%r10\n"
+	"	je	3f\n"
+	"	ahi	%r7,1\n"
+	"3:	lctl	%c1,%c1,4(%r13)\n"
+	"	l	%r1,0(%r6)\n"
+	"	cr	%r1,%r10\n"
+	"	je	4f\n"
+	"	ahi	%r7,1\n"
+	"4:	diag	8,0,0x501\n"
+	"1:	lctl	%c1,%c1,4(%r13)\n"
+	"	l	%r1,0(%r6)\n"
+	"	brct	%r5,g_xswitch_new\n"
+	"	diag	9,0,0x501\n"
+	"g_xread_new:	st	%r5,8(%r12)\n"
+	"	l	%r8,0(%r12)\n"
+	"	l	%r1,0(%r6)\n"
+	"	ltr	%r8,%r8\n"
+	"	jz	1f\n"
+	"	cr	%r1,%r10\n"
+	"	je	2f\n"
+	"	ahi	%r7,1\n"
+	"2:	diag	8,0,0x501\n"
+	"1:	brct	%r5,g_xread_new\n"
+	"	diag	9,0,0x501\n"
+    /* r11 PTO, r6 va, r3 flag value, r12 FLAG */
+	"g_xipte:	ipte	%r11,%r6\n"
+	"	st	%r3,0(%r12)\n"
+	"	diag	8,0,0x501\n"
+    /* r2 PTE, r4 new entry, r13 CSP_WORD | 1, r0/r1 0 */
+	"g_xcsp:	st	%r4,0(%r2)\n"
+	"	csp	%r0,%r13\n"
+	"	st	%r3,0(%r12)\n"
+	"	diag	8,0,0x501\n"
+	"g_sigp:	sigp	%r6,%r2,3\n"
+	"	ipm	%r3\n"
+	"	diag	8,0,0x501\n"
+	"g_eloop:	st	%r5,8(%r12)\n"
+	"	j	g_eloop\n"
+    /* r2 va: load it in the home space, r4 from IAC there */
+	"g_home:	sac	0x300\n"
+	"	l	%r1,0(%r2)\n"
+	"	iac	%r4\n"
+	"	sac	0\n"
+	"	diag	8,0,0x501\n"
+	"g_home_sacf:	sacf	0x300\n"
+	"	l	%r1,0(%r2)\n"
+	"	sacf	0\n"
+	"	diag	8,0,0x501\n"
+	"g_sac_sec:	sac	0x100\n"
+	"	diag	8,0,0x501\n"
+	"s_svc:	diag	1,0,0x501\n"
+	"s_ext:	diag	2,0,0x501\n"
+	"s_pgm:	diag	5,0,0x501\n"
+    /* runs at V_CODE only: position independent */
+	"g_code_v:	basr	%r5,0\n"
+	"	l	%r1,0(%r2)\n	diag	8,0,0x501\n"
+	"g_code_v_st:	st	%r3,0(%r2)\n	diag	8,0,0x501\n"
+	"g_code_v_end:\n"
+	"g_end:\n"
+	"	.popsection\n");
+
+static struct kvm_vm *vm;
+static u8 *mem;
+
+static u64 gaddr(const char *label)
+{
+	return GUEST_CODE + (label - g_start);
+}
+
+static u32 rd32(unsigned long a)
+{
+	return be32toh(*(u32 *)(mem + a));
+}
+
+static u16 rd16(unsigned long a)
+{
+	return be16toh(*(u16 *)(mem + a));
+}
+
+static void wr32(unsigned long a, u32 v)
+{
+	*(u32 *)(mem + a) = htobe32(v);
+}
+
+static u64 rd64(unsigned long a)
+{
+	return be64toh(*(u64 *)(mem + a));
+}
+
+static void wr_esa_psw(unsigned long a, u32 mask, u64 ia)
+{
+	wr32(a, mask | ESA_PSW_BIT12);
+	wr32(a + 4, 0x80000000U | ia);
+}
+
+static void setup_lowcore(unsigned long lc)
+{
+	memset(mem + lc, 0, 0x1000);
+	wr_esa_psw(lc + ESA_SVC_NEW, 0, gaddr(s_svc));
+	wr_esa_psw(lc + ESA_EXT_NEW, 0, gaddr(s_ext));
+	wr_esa_psw(lc + ESA_PGM_NEW, 0, gaddr(s_pgm));
+}
+
+static void setup_tables(void)
+{
+	int i;
+
+	for (i = 0; i < 16; i++)
+		wr32(STO + 4 * i, ESA_STE_I);
+	wr32(STO, PTO0 | 0xf);
+	wr32(STO + 4, PTO1 | 0xf);
+	for (i = 0; i < 256; i++) {
+		wr32(PTO0 + 4 * i, i << 12);
+		wr32(PTO1 + 4 * i, ESA_PTE_I);
+	}
+	wr32(PTO1 + 0 * 4, R_CODE);
+	wr32(PTO1 + 2 * 4, R_PROT | ESA_PTE_P);
+	wr32(PTO1 + 3 * 4, R_DATA_A);
+	wr32(PTO1 + 4 * 4, R_NOMEM);
+	wr32(R_DATA_A, 0xaaaaaaaa);
+	wr32(R_DATA_B, 0xbbbbbbbb);
+	memcpy(mem + R_CODE, g_code_v, g_code_v_end - g_code_v);
+	for (i = 0; i < NR_MANY; i++)
+		memcpy(mem + STO_MANY + i * 0x1000, mem + STO, 64);
+	memcpy(mem + STO_HOME, mem + STO, 64);
+	memcpy(mem + STO2, mem + STO, 64);
+	wr32(STD_PAIR, STD);
+	wr32(STD_PAIR + 4, STO2 | 0);
+	memcpy(mem + PTO1_HOME, mem + PTO1, 1024);
+	wr32(STO_HOME + 4, PTO1_HOME | 0xf);
+	wr32(PTO1_HOME + 3 * 4, R_DATA_B);
+}
+
+static void set_cr(struct kvm_vcpu *vcpu, int n, u32 val)
+{
+	vcpu->run->s.regs.crs[n] = val;
+	vcpu->run->kvm_dirty_regs |= KVM_SYNC_CRS;
+}
+
+static void set_crs(struct kvm_vcpu *vcpu, u32 cr0, u32 cr1)
+{
+	vcpu->run->s.regs.crs[0] = cr0;
+	vcpu->run->s.regs.crs[1] = cr1;
+	vcpu->run->kvm_dirty_regs |= KVM_SYNC_CRS;
+}
+
+/* run @label with or without DAT and with r2..r4 set; return the exit */
+static int run(struct kvm_vcpu *vcpu, u64 ia, bool dat, u64 r2, u64 r3, u64 r4)
+{
+	struct kvm_run *r = vcpu->run;
+
+	r->psw_mask = PSW_MASK_BA | (dat ? PSW_MASK_DAT : 0);
+	r->psw_addr = ia;
+	r->s.regs.gprs[2] = r2;
+	r->s.regs.gprs[3] = r3;
+	r->s.regs.gprs[4] = r4;
+	r->kvm_dirty_regs |= KVM_SYNC_GPRS;
+	vcpu_run(vcpu);
+	TEST_ASSERT(r->exit_reason == KVM_EXIT_S390_SIEIC &&
+		    r->s390_sieic.icptcode == ICPT_INST &&
+		    (r->s390_sieic.ipa & 0xff0f) == 0x8300 &&
+		    r->s390_sieic.ipb == 0x05010000,
+		    "exit %u icpt 0x%02x ipa 0x%04x ipb 0x%08x psw 0x%016llx 0x%016llx",
+		    r->exit_reason, r->s390_sieic.icptcode, r->s390_sieic.ipa,
+		    r->s390_sieic.ipb, r->psw_mask, r->psw_addr);
+	return (r->s390_sieic.ipa >> 4) & 0xf;
+}
+
+static u32 gpr(struct kvm_vcpu *vcpu, int n)
+{
+	return vcpu->run->s.regs.gprs[n];
+}
+
+static void test_interface(void)
+{
+	struct kvm_vm *v = vm_create_barebones();
+	int rc;
+
+	vm_enable_cap(v, KVM_CAP_S390_USER_SIGP, 0);
+	rc = __vm_enable_cap(v, KVM_CAP_S390_ESA390_CM, 2);
+	TEST_ASSERT(rc == -1 && errno == EINVAL, "unknown flag accepted");
+	rc = __vm_enable_cap(v, KVM_CAP_S390_ESA390_CM, KVM_S390_ESA390_CM_DAT);
+	kvm_vm_free(v);
+	if (rc)
+		ksft_exit_skip("KVM_S390_ESA390_CM_DAT not supported\n");
+	ksft_test_result_pass("capability flag: unknown flags refused, DAT flag accepted\n");
+}
+
+/* LOAD REAL ADDRESS with DAT off and on, all condition codes */
+static void test_lra(struct kvm_vcpu *vcpu)
+{
+	static const struct { u64 va; u32 r1; int cc; } t[] = {
+		{ V_CODE + 0x123, R_CODE + 0x123, 0 },
+		{ 0x2345, 0x2345, 0 },
+		{ V_SEG2, STO + 8, 1 },
+		{ V_INVALID, PTO1 + 4, 2 },
+		{ V_SEG16, STO + 64, 3 },
+	};
+	int i, dat, n, bad = 0;
+
+	for (dat = 0; dat < 2; dat++) {
+		for (i = 0; i < ARRAY_SIZE(t); i++) {
+			n = run(vcpu, gaddr(g_lra), dat, t[i].va, 0, 0);
+			if (n != EXIT_DONE || gpr(vcpu, 1) != t[i].r1 ||
+			    ((gpr(vcpu, 3) >> 28) & 3) != t[i].cc) {
+				bad++;
+				ksft_print_msg("LRA %s va %llx: exit %d r1 %08x cc %u\n",
+					       dat ? "DAT on" : "DAT off",
+					       (unsigned long long)t[i].va,
+					       n, gpr(vcpu, 1), (gpr(vcpu, 3) >> 28) & 3);
+			}
+		}
+	}
+	ksft_test_result(!bad, "LRA with DAT off and on: cc 0-3 and R1 as the architecture says\n");
+}
+
+static void test_translation(struct kvm_vcpu *vcpu)
+{
+	int n;
+
+	/* translated load through a non-identity page, code at a non-identity address */
+	n = run(vcpu, V_CODE, true, V_DATA, 0, 0);
+	ksft_test_result(n == EXIT_DONE && gpr(vcpu, 1) == 0xaaaaaaaa &&
+			 (vcpu->run->psw_mask & PSW_MASK_DAT),
+			 "translated code and data on non-identity pages (exit %d, r1 %08x, psw %016llx)\n",
+			 n, gpr(vcpu, 1), vcpu->run->psw_mask);
+
+	/* page-translation exception: nullified, TEID = page */
+	n = run(vcpu, gaddr(g_load), true, V_INVALID + 0x234, 0, 0);
+	ksft_test_result(n == EXIT_PGM && rd16(LC_PGM_CODE + 2) == 0x11 &&
+			 rd16(LC_PGM_CODE) == 4 && rd32(LC_TEID) == V_INVALID &&
+			 rd32(ESA_PGM_OLD) == (ESA_PSW_BIT12 | ESA_PSW_DAT) &&
+			 rd32(ESA_PGM_OLD + 4) == (0x80000000U | gaddr(g_load)),
+			 "page-translation exception (code %x ilc %u teid %08x old psw %016lx)\n",
+			 rd16(LC_PGM_CODE + 2), rd16(LC_PGM_CODE), rd32(LC_TEID),
+			 rd64(ESA_PGM_OLD));
+
+	/* segment-translation exception */
+	n = run(vcpu, gaddr(g_load), true, V_SEG2, 0, 0);
+	ksft_test_result(n == EXIT_PGM && rd16(LC_PGM_CODE + 2) == 0x10 &&
+			 rd32(LC_TEID) == V_SEG2,
+			 "segment-translation exception (code %x teid %08x)\n",
+			 rd16(LC_PGM_CODE + 2), rd32(LC_TEID));
+
+	/* page protection: suppressed, TEID bit 29 */
+	wr32(R_PROT, 0x12345678);
+	n = run(vcpu, gaddr(g_store), true, V_PROT, 0x55555555, 0);
+	ksft_test_result(n == EXIT_PGM && rd16(LC_PGM_CODE + 2) == 0x04 &&
+			 rd32(LC_TEID) == (V_PROT | 4) && rd32(R_PROT) == 0x12345678 &&
+			 rd32(ESA_PGM_OLD + 4) == (0x80000000U | (gaddr(g_store) + 4)),
+			 "protection exception, operation suppressed (code %x teid %08x old psw %016lx)\n",
+			 rd16(LC_PGM_CODE + 2), rd32(LC_TEID), rd64(ESA_PGM_OLD));
+
+	/* a page frame outside the configuration */
+	n = run(vcpu, gaddr(g_load), true, V_NOMEM, 0, 0);
+	ksft_test_result(n == EXIT_PGM && rd16(LC_PGM_CODE + 2) == 0x05,
+			 "frame outside the configuration: addressing exception (code %x)\n",
+			 rd16(LC_PGM_CODE + 2));
+}
+
+/* the shadow follows the guest's purges, not its stores */
+/*
+ * The purges drop shadows, and the next one may be built in the same pages
+ * with the same ASCE: repeated, so that the machine's own translations for
+ * that ASCE would be found if they survived.
+ */
+#define PURGE_ROUNDS	100
+
+static void test_purge(struct kvm_vcpu *vcpu)
+{
+	int n1, n2, n3, i, bad = 0;
+	u32 a = 0, b = 0;
+
+	for (i = 0; i < PURGE_ROUNDS; i++) {
+		wr32(PTO1 + 3 * 4, R_DATA_A);
+		TEST_ASSERT_EQ(run(vcpu, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+		n1 = run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+		a = gpr(vcpu, 1);
+		/* change the valid entry and purge: the new mapping must be used */
+		wr32(PTO1 + 3 * 4, R_DATA_B);
+		n2 = run(vcpu, gaddr(g_ptlb), false, 0, 0, 0);
+		n3 = run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+		b = gpr(vcpu, 1);
+		if (n1 != EXIT_DONE || n2 != EXIT_DONE || n3 != EXIT_DONE ||
+		    a != 0xaaaaaaaa || b != 0xbbbbbbbb)
+			bad++;
+	}
+	ksft_test_result(!bad,
+			 "PTLB after a table change, %d rounds (%d wrong, last %08x then %08x)\n",
+			 PURGE_ROUNDS, bad, a, b);
+
+	/* IPTE: invalid bit set in guest storage, translation gone */
+	n1 = run(vcpu, gaddr(g_ipte), false, V_DATA, 0, PTO1);
+	n2 = run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+	ksft_test_result(n1 == EXIT_DONE && (rd32(PTO1 + 12) & ESA_PTE_I) &&
+			 n2 == EXIT_PGM && rd16(LC_PGM_CODE + 2) == 0x11,
+			 "IPTE invalidates the entry and the shadow (pte %08x, code %x)\n",
+			 rd32(PTO1 + 12), rd16(LC_PGM_CODE + 2));
+
+	/* CSP with the purge bit, from translated code */
+	for (bad = 0, i = 0; i < PURGE_ROUNDS; i++) {
+		wr32(PTO1 + 3 * 4, R_DATA_A);
+		wr32(0x3000, 7);
+		TEST_ASSERT_EQ(run(vcpu, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+		n1 = run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+		wr32(PTO1 + 3 * 4, R_DATA_B);
+		n2 = run(vcpu, gaddr(g_csp), true, 0x3000 | 1, 0, 7);
+		n3 = run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+		if (n1 != EXIT_DONE || n2 != EXIT_DONE || ((gpr(vcpu, 3) >> 28) & 3) ||
+		    n3 != EXIT_DONE || gpr(vcpu, 1) != 0xbbbbbbbb)
+			bad++;
+	}
+	ksft_test_result(!bad,
+			 "CSP with purge from translated code, %d rounds (%d wrong, last r1 %08x)\n",
+			 PURGE_ROUNDS, bad, gpr(vcpu, 1));
+}
