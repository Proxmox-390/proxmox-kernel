+/* the secondary space is not provided: KVM_RUN fails, nothing hangs */
+static void test_secondary_refused(struct kvm_vcpu *vcpu)
+{
+	struct kvm_run *r = vcpu->run;
+	int rc;
+
+	r->psw_mask = PSW_MASK_BA | PSW_MASK_DAT;
+	r->psw_addr = gaddr(g_sac_sec);
+	rc = __vcpu_run(vcpu);
+	ksft_test_result(rc < 0 && errno == EOPNOTSUPP,
+			 "SAC to the secondary space while translated: KVM_RUN fails with EOPNOTSUPP (%d %d)\n",
+			 rc, errno);
+	set_cr(vcpu, 0, CR0_DAT);
+	TEST_ASSERT_EQ(run(vcpu, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+}
