+/*
+ * An odd instruction address is recognized only when an instruction is
+ * fetched: LPSW of a wait PSW with one is valid, the interruption ending
+ * the wait stores it.
+ */
+static void test_odd_wait(struct kvm_vcpu *vcpu)
+{
+	u64 tod, ckc;
+	int n;
+
+	wr_esa_psw(0x3200, ESA_PSW_DAT | ESA_PSW_EXT | 0x00020000U, 0x4001);
+	alarm(20);
+	kvm_device_attr_get(vm->fd, KVM_S390_VM_TOD, KVM_S390_VM_TOD_LOW, &tod);
+	ckc = tod + (50000ULL << 12);		/* 50 ms */
+	vcpu_set_reg(vcpu, KVM_REG_S390_CLOCK_COMP, ckc);
+	set_crs(vcpu, CR0_DAT | CR0_CKC, STD);
+	n = run(vcpu, gaddr(g_lpsw), true, 0x3200, 0, 0);
+	alarm(0);
+	ksft_test_result(n == EXIT_EXT && rd16(LC_EXT_CODE) == 0x1004 &&
+			 rd32(ESA_EXT_OLD + 4) == 0x80004001U,
+			 "LPSW of a wait PSW with an odd address while translated (exit %d, old psw %016lx)\n",
+			 n, rd64(ESA_EXT_OLD));
+	vcpu_set_reg(vcpu, KVM_REG_S390_CLOCK_COMP, -1ULL);
+	set_crs(vcpu, CR0_DAT, STD);
+}
