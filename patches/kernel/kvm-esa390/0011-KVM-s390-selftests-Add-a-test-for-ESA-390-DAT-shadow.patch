+/*
+ * A space whose virtual page 0 is not translated, then another space, then
+ * the first one again after its page 0 became valid (no purge needed for
+ * that): it reads the guest's page, not the page that stood in for it.
+ */
+static void test_page0_back(struct kvm_vcpu *vcpu)
+{
+	u64 v = 0x80;
+	int n;
+
+	memcpy(mem + PTO0_ALT, mem + PTO0, 1024);
+	wr32(PTO0_ALT, ESA_PTE_I);
+	memcpy(mem + STO3, mem + STO, 64);
+	wr32(STO3, PTO0_ALT | 0xf);
+	wr32(R_DATA_B + v, 0x5c5c5c5c);
+
+	set_crs(vcpu, CR0_DAT, STO3);
+	TEST_ASSERT_EQ(run(vcpu, gaddr(g_load), true, 0x1200, 0, 0), EXIT_DONE);
+	set_crs(vcpu, CR0_DAT, STD);
+	TEST_ASSERT_EQ(run(vcpu, gaddr(g_load), true, 0x1200, 0, 0), EXIT_DONE);
+	wr32(PTO0_ALT, R_DATA_B);
+	set_crs(vcpu, CR0_DAT, STO3);
+	n = run(vcpu, gaddr(g_load), true, v, 0, 0);
+	ksft_test_result(n == EXIT_DONE && gpr(vcpu, 1) == 0x5c5c5c5c,
+			 "virtual page 0 made valid while its space was not in use is used when it is again (%d %08x)\n",
+			 n, gpr(vcpu, 1));
+	set_crs(vcpu, CR0_DAT, STD);
+	TEST_ASSERT_EQ(run(vcpu, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+	wr32(R_DATA_B + v, 0);
+}
+
+/* more segment tables than shadows are kept: still correct, older ones recreated */
+static void test_bound(struct kvm_vcpu *vcpu)
+{
+	u64 created0, created1, created2;
+	int i, bad = 0;
+
+	created0 = vm_get_stat(vm, gmap_shadow_create);
+	for (i = 0; i < NR_MANY; i++) {
+		set_crs(vcpu, CR0_DAT, STO_MANY + i * 0x1000);
+		if (run(vcpu, gaddr(g_load), true, V_DATA, 0, 0) != EXIT_DONE ||
+		    gpr(vcpu, 1) != 0xaaaaaaaa)
+			bad++;
+	}
+	created1 = vm_get_stat(vm, gmap_shadow_create);
+	/* the first ones were dropped: recreated */
+	set_crs(vcpu, CR0_DAT, STO_MANY);
+	run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+	created2 = vm_get_stat(vm, gmap_shadow_create);
+	set_crs(vcpu, CR0_DAT, STD);
+	ksft_test_result(!bad && created1 - created0 == NR_MANY && created2 == created1 + 1,
+			 "%d segment tables: translation right, least recently used shadows dropped (%llu %llu)\n",
+			 NR_MANY, (unsigned long long)(created1 - created0),
+			 (unsigned long long)(created2 - created1));
+}
+
+/*
+ * Virtual page 0 not translated: SIE still needs a prefix page, KVM's stands
+ * in for it. Once the guest makes the segment valid (no purge needed for
+ * invalid -> valid), virtual 0 is the guest's page again.
+ */
+static void test_page0_invalid(struct kvm_vcpu *vcpu)
+{
+	int n1, n2;
+	u32 a, b;
+
+	wr32(0x200, 0x11111111);
+	wr32(STO, ESA_STE_I);
+	n1 = run(vcpu, V_CODE, true, V_DATA, 0, 0);
+	a = gpr(vcpu, 1);
+	wr32(STO, PTO0 | 0xf);
+	n2 = run(vcpu, V_CODE, true, 0x200, 0, 0);
+	b = gpr(vcpu, 1);
+	ksft_test_result(n1 == EXIT_DONE && a == 0xaaaaaaaa && n2 == EXIT_DONE && b == 0x11111111,
+			 "translated code runs while virtual page 0 is invalid; valid again without purge (%d %08x %d %08x)\n",
+			 n1, a, n2, b);
+}
+
+/* after a switch to z/Architecture, the purges are the machine's again */
+static void test_zarch_after(struct kvm_vcpu *vcpu)
+{
+	u32 mode = KVM_S390_ARCH_MODE_ZARCH;
+	u64 ins0;
+	int n;
+
+	n = run(vcpu, gaddr(g_load), true, V_DATA, 0, 0);
+	TEST_ASSERT_EQ(n, EXIT_DONE);
+	kvm_device_attr_set(vm->fd, KVM_S390_VM_ARCH_MODE, KVM_S390_VM_ARCH_MODE_CURRENT, &mode);
+	ins0 = vcpu_get_stat(vcpu, exit_instruction);
+	n = run(vcpu, gaddr(g_ptlb), false, 0, 0, 0);
+	ksft_test_result(n == EXIT_DONE && vcpu_get_stat(vcpu, exit_instruction) == ins0 + 1,
+			 "z/Architecture after DAT shadowing: PTLB runs without interception (%llu exits)\n",
+			 (unsigned long long)(vcpu_get_stat(vcpu, exit_instruction) - ins0));
+}
+
+/*
+ * The guest changes a valid entry and purges, many times: with PTLB, and
+ * with IPTE followed by a new valid entry (invalid -> valid, no purge).
+ */
+static void test_stress(struct kvm_vcpu *vcpu)
+{
+	__u64 *g = vcpu->run->s.regs.gprs;
+	int n;
+
+	g[5] = 20000;
+	g[6] = V_DATA;
+	g[7] = 0;
+	g[9] = 0xaaaaaaaa;
+	g[10] = 0xbbbbbbbb;
+	g[11] = PTO1;
+	n = run(vcpu, gaddr(g_stress), true, PTO1 + 12, R_DATA_A, R_DATA_B);
+	ksft_test_result(n == EXIT_DONE && !gpr(vcpu, 7),
+			 "40000 table changes by translated code, each seen after its purge (%u wrong)\n",
+			 gpr(vcpu, 7));
+	wr32(PTO1 + 12, R_DATA_A);
+}
+
+/*
+ * While virtual page 0 is not translated, a page of KVM stands in for it as
+ * SIE's prefix page. A store to its first 512 bytes still gets the
+ * translation exception.
+ */
+static void test_page0_store(struct kvm_vcpu *vcpu)
+{
+	u64 va_st = V_CODE + (g_code_v_st - g_code_v);
+	int n;
+
+	wr32(STO, ESA_STE_I);
+	wr32(0x80, 0x12345678);
+	TEST_ASSERT_EQ(run(vcpu, gaddr(g_ptlb), false, 0, 0, 0), EXIT_DONE);
+	n = run(vcpu, va_st, true, 0x80, 0x55555555, 0);
+	ksft_test_result(n == EXIT_PGM && rd16(LC_PGM_CODE + 2) == 0x10 &&
+			 rd32(LC_TEID) == 0 && rd32(0x80) == 0x12345678 &&
+			 rd32(ESA_PGM_OLD + 4) == (0x80000000U | va_st),
+			 "store to untranslated virtual page 0: segment-translation exception (code %x teid %08x old psw %016lx)\n",
+			 rd16(LC_PGM_CODE + 2), rd32(LC_TEID), rd64(ESA_PGM_OLD));
+
+	wr32(STO, PTO0 | 0xf);
+}
+
+/* nothing of the shadow appears in guest storage */
+static void test_no_guest_storage(u32 sum_before, u32 sum_after)
+{
+	ksft_test_result(sum_before == sum_after,
+			 "guest storage outside what the guest wrote is unchanged (%08x %08x)\n",
+			 sum_before, sum_after);
+}
+
+static u32 checksum_unused(void)
+{
+	u32 sum = 0;
+	unsigned long a;
+
+	/* 0x160000.. is never written by the guest or the test */
+	for (a = 0x160000; a < GUEST_MEM_PAGES * 0x1000UL; a += 4)
+		sum = sum * 31 + rd32(a);
+	return sum;
+}
+
+int main(int argc, char *argv[])
+{
+	struct kvm_vcpu *vcpu0, *vcpu1;
+	u32 mode = KVM_S390_ARCH_MODE_ESA390_CM;
+	u32 sum;
+	unsigned long a;
+
+	TEST_REQUIRE(kvm_has_cap(KVM_CAP_S390_ESA390_CM));
+	ksft_print_header();
+	ksft_set_plan(33);
+
+	test_interface();
+
+	vm = vm_create_barebones();
+	vm_enable_cap(vm, KVM_CAP_S390_USER_SIGP, 0);
+	vm_enable_cap(vm, KVM_CAP_S390_ESA390_CM, KVM_S390_ESA390_CM_DAT);
+	vm_userspace_mem_region_add(vm, VM_MEM_SRC_ANONYMOUS, 0, 0, GUEST_MEM_PAGES, 0);
+	mem = addr_gpa2hva(vm, 0);
+	for (a = 0x160000; a < GUEST_MEM_PAGES * 0x1000UL; a += 4)
+		wr32(a, a * 2654435761U);
+	sum = checksum_unused();
+	memcpy(mem + GUEST_CODE, g_start, g_end - g_start);
+	setup_tables();
+	setup_lowcore(0);
+	setup_lowcore(PREFIX1);
+	kvm_device_attr_set(vm->fd, KVM_S390_VM_ARCH_MODE, KVM_S390_VM_ARCH_MODE_CURRENT, &mode);
+
+	vcpu0 = __vm_vcpu_add(vm, 0);
+	vcpu1 = __vm_vcpu_add(vm, 1);
+	vcpu1->run->s.regs.prefix = PREFIX1;
+	vcpu1->run->kvm_dirty_regs |= KVM_SYNC_PREFIX;
+	set_crs(vcpu0, CR0_DAT, STD);
+	set_crs(vcpu1, CR0_DAT, STD);
+
+	vcpu0->run->psw_mask = PSW_MASK_BA;
+	vcpu0->run->psw_addr = gaddr(g_ptlb);
+	if (__vcpu_run(vcpu0) < 0 && errno == EINVAL)
+		ksft_exit_skip("the host does not run ESA/390-format state descriptions\n");
+
+	test_lra(vcpu0);
+	test_translation(vcpu0);
+	test_purge(vcpu0);
+	test_sysmask(vcpu0);
+	test_svc_lpsw(vcpu0);
+	test_ckc(vcpu0);
+	test_odd_wait(vcpu0);
+	test_home_space(vcpu0);
+	test_space_switch(vcpu0);
+	test_secondary_refused(vcpu0);
+	test_two_cpus(vcpu0, vcpu1);
+	test_cross_ipte(vcpu0, vcpu1, false);
+	test_cross_csp(vcpu0, vcpu1, false);
+	test_cross_ipte(vcpu0, vcpu1, true);
+	test_cross_csp(vcpu0, vcpu1, true);
+	test_prefix_ipte(vcpu0, vcpu1);
+	test_sigp_emergency(vcpu0, vcpu1);
+	test_bound(vcpu0);
+	test_page0_invalid(vcpu0);
+	test_page0_back(vcpu0);
+	test_page0_store(vcpu0);
+	test_stress(vcpu0);
+	test_no_guest_storage(sum, checksum_unused());
+	test_zarch_after(vcpu0);
+
+	kvm_vm_free(vm);
+	ksft_finished();
+}
