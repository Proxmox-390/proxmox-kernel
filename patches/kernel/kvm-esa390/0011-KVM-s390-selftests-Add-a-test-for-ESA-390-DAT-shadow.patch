+/* a clock-comparator interruption reaches a translated loop */
+static void test_ckc(struct kvm_vcpu *vcpu)
+{
+	struct kvm_run *r = vcpu->run;
+	u64 tod, ckc;
+
+	alarm(20);
+	kvm_device_attr_get(vm->fd, KVM_S390_VM_TOD, KVM_S390_VM_TOD_LOW, &tod);
+	ckc = tod + (100000ULL << 12);		/* 100 ms */
+	vcpu_set_reg(vcpu, KVM_REG_S390_CLOCK_COMP, ckc);
+	set_crs(vcpu, CR0_DAT | CR0_CKC, STD);
+	r->psw_mask = PSW_MASK_BA | PSW_MASK_DAT | PSW_MASK_EXT;
+	r->psw_addr = gaddr(g_loop);
+	vcpu_run(vcpu);
+	alarm(0);
+	ksft_test_result(r->exit_reason == KVM_EXIT_S390_SIEIC &&
+			 ((r->s390_sieic.ipa >> 4) & 0xf) == EXIT_EXT &&
+			 rd16(LC_EXT_CODE) == 0x1004 &&
+			 rd32(ESA_EXT_OLD) == (ESA_PSW_BIT12 | ESA_PSW_DAT | ESA_PSW_EXT),
+			 "clock comparator interrupts a translated loop (code %04x, old psw %016lx)\n",
+			 rd16(LC_EXT_CODE), rd64(ESA_EXT_OLD));
+	vcpu_set_reg(vcpu, KVM_REG_S390_CLOCK_COMP, -1ULL);
+	set_crs(vcpu, CR0_DAT, STD);
+}
