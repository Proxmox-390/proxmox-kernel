+/* the system-mask instructions see and change the guest's DAT bit */
+static void test_sysmask(struct kvm_vcpu *vcpu)
+{
+	int n;
+
+	mem[0x3100] = 0;
+	n = run(vcpu, gaddr(g_stnsm), true, 0x3100, 0, 0);
+	ksft_test_result(n == EXIT_DONE && mem[0x3100] == (ESA_PSW_DAT >> 24),
+			 "STNSM stores the DAT bit (%02x)\n", mem[0x3100]);
+	n = run(vcpu, gaddr(g_stnsm_off), true, 0x3100, 0, 0);
+	ksft_test_result(n == EXIT_DONE2 && !(vcpu->run->psw_mask & PSW_MASK_DAT),
+			 "STNSM turns DAT off (psw %016llx)\n", vcpu->run->psw_mask);
+}
+
+static void test_svc_lpsw(struct kvm_vcpu *vcpu)
+{
+	int n;
+
+	n = run(vcpu, gaddr(g_svc), true, 0, 0, 0);
+	ksft_test_result(n == EXIT_SVC && rd32(LC_SVC_CODE) == 0x20042 &&
+			 rd32(ESA_SVC_OLD) == (ESA_PSW_BIT12 | ESA_PSW_DAT) &&
+			 rd32(ESA_SVC_OLD + 4) == (0x80000000U | (gaddr(g_svc) + 2)),
+			 "SVC while translated: ESA/390 old PSW with DAT (%016lx, code %08x)\n",
+			 rd64(ESA_SVC_OLD), rd32(LC_SVC_CODE));
+
+	/* LPSW with DAT off loads a DAT-on PSW */
+	wr_esa_psw(0x3200, ESA_PSW_DAT, V_CODE);
+	n = run(vcpu, gaddr(g_lpsw), false, 0x3200, 0, 0);
+	wr32(PTO1 + 3 * 4, R_DATA_A);
+	ksft_test_result(n == EXIT_DONE && (vcpu->run->psw_mask & PSW_MASK_DAT),
+			 "LPSW from DAT off into translated code (psw %016llx)\n",
+			 vcpu->run->psw_mask);
+}
