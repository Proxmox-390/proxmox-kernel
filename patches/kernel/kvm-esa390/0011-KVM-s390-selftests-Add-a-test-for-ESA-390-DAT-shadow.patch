+/* SAC and SACF to the home space translate with control register 13 */
+static void test_home_space(struct kvm_vcpu *vcpu)
+{
+	u32 r1, r4;
+	int n, m;
+
+	set_cr(vcpu, 0, CR0_DAT | CR0_SAC);
+	set_cr(vcpu, 13, STD_HOME);
+	n = run(vcpu, gaddr(g_home), true, V_DATA, 0, 0);
+	r1 = gpr(vcpu, 1);
+	r4 = gpr(vcpu, 4);
+	m = run(vcpu, gaddr(g_home_sacf), true, V_DATA, 0, 0);
+	ksft_test_result(n == EXIT_DONE && r1 == 0xbbbbbbbb && (r4 & 0xff00) == 0x300 &&
+			 m == EXIT_DONE && gpr(vcpu, 1) == 0xbbbbbbbb &&
+			 !(vcpu->run->psw_mask & 0x0000c00000000000ULL),
+			 "home space by SAC and SACF, IAC reports it (r1 %08x iac %04x, sacf r1 %08x)\n",
+			 r1, r4 & 0xff00, gpr(vcpu, 1));
+}
+
+/* a switch to the home space with a space-switch-event control */
+static void test_space_switch(struct kvm_vcpu *vcpu)
+{
+	u32 old_mask, old_addr;
+	u16 code;
+	int n;
+
+	set_cr(vcpu, 1, STD | STD_SSE);
+	n = run(vcpu, gaddr(g_home), true, V_DATA, 0, 0);
+	code = rd16(LC_PGM_CODE + 2);
+	old_mask = rd32(ESA_PGM_OLD);
+	old_addr = rd32(ESA_PGM_OLD + 4) & 0x7fffffff;
+	ksft_test_result(n == EXIT_PGM && code == 0x1c &&
+			 (old_mask & ESA_PSW_HOME) == ESA_PSW_HOME &&
+			 old_addr == gaddr(g_home) + 4 && (rd32(LC_TEID) & 0x80000000),
+			 "space-switch event after SAC to the home space (code %x old psw %08x %08x teid %08x)\n",
+			 code, old_mask, old_addr, rd32(LC_TEID));
+	set_cr(vcpu, 1, STD);
+}
