 	if (!parent)
 		return -EAGAIN;
+	if (is_esa390_shadow(sg))
+		return walk_esa390_tables(sg, saddr, w, wr);
 	kvm = parent->kvm;
 	WARN_ON(!kvm);
 	asce = sg->guest_asce;
@@ -1537,11 +1688,27 @@ static int _gaccess_do_shadow(struct kvm_s390_mmu_cache *mc, struct gmap *sg,
 		goto real_address_space;
 	}
 
