+/**
+ * gmap_create_shadow() - Create/find a shadow guest address space.
+ * @mc: The cache to use to allocate dat tables.
+ * @parent: Pointer to the parent gmap.
+ * @asce: ASCE for which the shadow table is created.
+ * @edat_level: Edat level to be used for the shadow translation.
+ *
+ * The pages of the top level page table referred by the asce parameter
+ * will be set to read-only and marked in the PGSTEs of the kvm process.
+ * The shadow table will be removed automatically on any change to the
+ * PTE mapping for the source table.
+ *
+ * The returned shadow gmap will be returned with one extra reference.
+ *
+ * Return: A guest address space structure, ERR_PTR(-ENOMEM) if out of memory,
+ * ERR_PTR(-EAGAIN) if the caller has to retry and ERR_PTR(-EFAULT) if the
+ * parent gmap table could not be protected.
+ */
+struct gmap *gmap_create_shadow(struct kvm_s390_mmu_cache *mc, struct gmap *parent,
+				union asce asce, int edat_level)
+{
+	return _gmap_create_shadow(mc, parent, asce, edat_level, NULL);
+}
+
+/**
+ * gmap_create_esa390_shadow() - Create/find a shadow of ESA/390 tables.
+ * @mc: The cache to use to allocate dat tables.
+ * @parent: Pointer to the parent gmap.
+ * @std: Segment-table designation (STO, private-space bit, STL).
+ * @prefix: Prefix of the CPU that uses the shadow.
+ *
+ * As gmap_create_shadow(), for a 31-bit address space translated with
+ * ESA/390 segment and page tables. The address space is the one a CPU with
+ * prefix @prefix sees with DAT off: a shadow address is the virtual address
+ * after prefixing. The table origins are used as absolute addresses.
+ *
+ * Nothing is write-protected: like a TLB, the shadow keeps translations of
+ * changed table entries until the guest purges them.
+ *
+ * Return: See gmap_create_shadow().
+ */
+struct gmap *gmap_create_esa390_shadow(struct kvm_s390_mmu_cache *mc, struct gmap *parent,
+				       u32 std, u32 prefix)
+{
+	struct gmap_esa390_key key = { .std = std, .prefix = prefix };
+	union asce asce = { .val = std & ESA390_STD_STO };
+
+	asce.dt = ASCE_TYPE_SEGMENT;
+	asce.tl = _ASCE_TABLE_LENGTH;
+	return _gmap_create_shadow(mc, parent, asce, 0, &key);
+}
