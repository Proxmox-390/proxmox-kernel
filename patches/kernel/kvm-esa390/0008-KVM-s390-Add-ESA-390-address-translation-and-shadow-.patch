+/*
+ * ESA/390 translation for accesses KVM makes on behalf of the guest. Only
+ * the primary space exists; the caller has checked the address-space
+ * control.
+ */
+static int esa390_translate_gva(struct kvm_vcpu *vcpu, unsigned long gva, unsigned long *gpa,
+				const union asce asce, enum gacc_mode mode, enum prot_type *prot)
+{
+	struct esa390_walk w;
+	int rc;
+
+	*prot = PROT_TYPE_DUMMY;
+	if (!kvm_s390_esa390_dat_format_valid(vcpu))
+		return PGM_TRANSLATION_SPEC;
+	rc = kvm_s390_esa390_walk(vcpu->kvm, asce.val, gva, NULL, &w);
+	if (rc)
+		return rc;
+	if (mode == GACC_STORE && w.p) {
+		*prot = PROT_TYPE_DAT;
+		return PGM_PROTECTION;
+	}
+	*gpa = kvm_s390_real_to_abs(vcpu, w.ra);
+	if (!kvm_is_gpa_in_memslot(vcpu->kvm, *gpa))
+		return PGM_ADDRESSING;
+	return 0;
+}
+
 static inline int is_low_address(struct kvm_vcpu *vcpu, unsigned long ga)
 {
 	/* ESA/390-compatibility mode: only the address range 0..511 */
@@ -789,7 +819,11 @@ static int guest_range_to_gpas(struct kvm_vcpu *vcpu, unsigned long ga, u8 ar,
 		if (mode == GACC_STORE && lap_enabled && is_low_address(vcpu, ga))
 			return trans_exc(vcpu, PGM_PROTECTION, ga, ar, mode,
 					 PROT_TYPE_LA);
-		if (psw_bits(*psw).dat) {
+		if (psw_bits(*psw).dat && kvm_s390_vcpu_is_esa(vcpu)) {
+			rc = esa390_translate_gva(vcpu, ga, &gpa, asce, mode, &prot);
+			if (rc < 0)
+				return rc;
+		} else if (psw_bits(*psw).dat) {
 			rc = guest_translate_gva(vcpu, ga, &gpa, asce, mode, &prot);
 			if (rc < 0)
 				return rc;
@@ -1263,6 +1297,121 @@ int kvm_s390_check_low_addr_prot_real(struct kvm_vcpu *vcpu, unsigned long gra)
 	return trans_exc(vcpu, PGM_PROTECTION, gra, 0, GACC_STORE, PROT_TYPE_LA);
 }
 
+/* ESA/390 segment-table and page-table entries */
+#define ESA390_STE_ZERO	0x80000000U
+#define ESA390_STE_PTO	0x7fffffc0U
+#define ESA390_STE_I	0x00000020U
+#define ESA390_STE_C	0x00000010U
+#define ESA390_STE_PTL	0x0000000fU
+#define ESA390_PTE_PFRA	0x7ffff000U
+#define ESA390_PTE_ZERO	0x80000900U
+#define ESA390_PTE_I	0x00000400U
+#define ESA390_PTE_P	0x00000200U
+
+static int esa390_read_entry(struct kvm *kvm, struct guest_fault *f, u32 gpa, u32 *val)
+{
+	unsigned long dw;
+	int rc;
+
+	if (f) {
+		rc = kvm_s390_get_guest_page_and_read_gpa(kvm, f, gpa & ~7UL, &dw);
+		if (!rc)
+			*val = gpa & 4 ? dw : dw >> 32;
+		return rc;
+	}
+	if (!kvm_is_gpa_in_memslot(kvm, gpa))
+		return PGM_ADDRESSING;
+	return kvm_read_guest(kvm, gpa, val, sizeof(*val)) ? -EFAULT : 0;
+}
+
+/**
+ * kvm_s390_esa390_walk() - Translate an ESA/390 virtual address.
+ * @kvm: The VM.
+ * @std: Segment-table designation.
+ * @va: Virtual address.
+ * @entries: If not NULL, entries[TABLE_TYPE_SEGMENT] and
+ *	     entries[TABLE_TYPE_PAGE_TABLE] receive the table pages.
+ * @w: Result.
+ *
+ * Table origins are used as absolute addresses. The checks are made in the
+ * order of the architecture; translation format and low-address protection
+ * are the caller's.
+ *
+ * Return: 0 if @w->ra holds the real address, a program-interruption code,
+ * or a negative error code.
+ */
+int kvm_s390_esa390_walk(struct kvm *kvm, u32 std, u32 va, struct guest_fault *entries,
+			 struct esa390_walk *w)
+{
+	u32 sx = (va >> 20) & 0x7ff, px = (va >> 12) & 0xff;
+	u32 ste, pte;
+	int rc;
+
+	w->len = false;
+	w->p = false;
+	w->entry = ((std & ESA390_STD_STO) + sx * 4) & 0x7fffffff;
+	if ((sx >> 4) > (std & ESA390_STD_STL)) {
+		w->len = true;
+		return PGM_SEGMENT_TRANSLATION;
+	}
+	rc = esa390_read_entry(kvm, entries ? entries + TABLE_TYPE_SEGMENT : NULL, w->entry, &ste);
+	if (rc)
+		return rc;
+	if (ste & ESA390_STE_I)
+		return PGM_SEGMENT_TRANSLATION;
+	if ((ste & ESA390_STE_ZERO) || ((ste & ESA390_STE_C) && (std & ESA390_STD_P)))
+		return PGM_TRANSLATION_SPEC;
+	w->entry = ((ste & ESA390_STE_PTO) + px * 4) & 0x7fffffff;
+	if ((px >> 4) > (ste & ESA390_STE_PTL)) {
+		w->len = true;
+		return PGM_PAGE_TRANSLATION;
+	}
+	rc = esa390_read_entry(kvm, entries ? entries + TABLE_TYPE_PAGE_TABLE : NULL, w->entry,
+			       &pte);
+	if (rc)
+		return rc;
+	if (pte & ESA390_PTE_I)
+		return PGM_PAGE_TRANSLATION;
+	if (pte & ESA390_PTE_ZERO)
+		return PGM_TRANSLATION_SPEC;
+	w->p = pte & ESA390_PTE_P;
+	w->ra = (pte & ESA390_PTE_PFRA) | (va & ~PAGE_MASK);
+	return 0;
+}
+
+/*
+ * The shadow address of an ESA/390 shadow gmap is the virtual address after
+ * prefixing; the real address it translates to is prefixed as well.
+ */
+static int walk_esa390_tables(struct gmap *sg, unsigned long saddr, struct pgtwalk *w, bool wr)
+{
+	struct guest_fault *entries = get_entries(w);
+	u32 va = _kvm_s390_real_to_abs_esa(sg->esa_prefix, saddr);
+	struct esa390_walk ew;
+	gfn_t gfn;
+	int rc;
+
+	/* sg->parent goes away when another CPU purges: use sg->kvm */
+	w->level = TABLE_TYPE_PAGE_TABLE;
+	rc = kvm_s390_esa390_walk(sg->kvm, sg->esa_std, va, entries, &ew);
+	w->last_addr = ew.entry;
+	if (rc)
+		return rc;
+	w->p = ew.p;
+	if (wr && w->p)
+		return PGM_PROTECTION;
+	gfn = gpa_to_gfn(_kvm_s390_real_to_abs_esa(sg->esa_prefix, ew.ra));
+	/*
+	 * Like a real space: a page the guest may store into is made writable
+	 * right away, the shadow mapping cannot be less writable than the
+	 * host mapping. A read-only memory slot gets a read-only mapping.
+	 */
+	rc = kvm_s390_get_guest_page(sg->kvm, entries + LEVEL_MEM, gfn, wr || !w->p);
+	if (rc == -EFAULT && !wr && !w->p)
+		rc = kvm_s390_get_guest_page(sg->kvm, entries + LEVEL_MEM, gfn, false);
+	return rc;
+}
+
