 		break;
+	case KVM_S390_VM_ARCH_MODE:
+		ret = kvm_s390_vm_get_arch_mode(kvm, attr);
+		break;
 	default:
 		ret = -ENXIO;
 		break;
@@ -2144,6 +2294,10 @@ static int kvm_s390_vm_has_attr(struct kvm *kvm, struct kvm_device_attr *attr)
 	case KVM_S390_VM_CPU_TOPOLOGY:
 		ret = test_kvm_facility(kvm, 11) ? 0 : -ENXIO;
 		break;
+	case KVM_S390_VM_ARCH_MODE:
+		ret = kvm->arch.esa390_cm &&
+		      attr->attr == KVM_S390_VM_ARCH_MODE_CURRENT ? 0 : -ENXIO;
+		break;
 	default:
 		ret = -ENXIO;
 		break;
@@ -3688,15 +3842,9 @@ static int kvm_s390_vcpu_setup(struct kvm_vcpu *vcpu)
 	int rc = 0;
 	u16 uvrc, uvrrc;
 
-	atomic_set(&vcpu->arch.sie_block->cpuflags, CPUSTAT_ZARCH |
-						    CPUSTAT_SM |
+	atomic_set(&vcpu->arch.sie_block->cpuflags, CPUSTAT_SM |
 						    CPUSTAT_STOPPED);
 
-	if (test_kvm_facility(vcpu->kvm, 78))
-		kvm_s390_set_cpuflags(vcpu, CPUSTAT_GED2);
-	else if (test_kvm_facility(vcpu->kvm, 8))
-		kvm_s390_set_cpuflags(vcpu, CPUSTAT_GED);
-
 	kvm_s390_vcpu_setup_model(vcpu);
 
 	/* pgste_set_pte has special handling for !machine_has_esop() */
@@ -3706,8 +3854,6 @@ static int kvm_s390_vcpu_setup(struct kvm_vcpu *vcpu)
 		vcpu->arch.sie_block->ecb |= ECB_SRSI;
 	if (test_kvm_facility(vcpu->kvm, 11))
 		vcpu->arch.sie_block->ecb |= ECB_PTF;
-	if (test_kvm_facility(vcpu->kvm, 73))
-		vcpu->arch.sie_block->ecb |= ECB_TE;
 	if (!kvm_is_ucontrol(vcpu->kvm))
 		vcpu->arch.sie_block->ecb |= ECB_SPECI;
 
@@ -3724,10 +3870,7 @@ static int kvm_s390_vcpu_setup(struct kvm_vcpu *vcpu)
 		vcpu->arch.sie_block->eca |= ECA_SII;
 	if (kvm_s390_use_sca_entries())
 		vcpu->arch.sie_block->eca |= ECA_SIGPI;
-	if (test_kvm_facility(vcpu->kvm, 129)) {
-		vcpu->arch.sie_block->eca |= ECA_VX;
-		vcpu->arch.sie_block->ecd |= ECD_HOSTREGMGMT;
-	}
+	kvm_s390_vcpu_set_arch_mode_controls(vcpu);
 	if (test_kvm_facility(vcpu->kvm, 139))
 		vcpu->arch.sie_block->ecd |= ECD_MEF;
 	if (test_kvm_facility(vcpu->kvm, 156))
@@ -4777,6 +4920,8 @@ static int __vcpu_run(struct kvm_vcpu *vcpu)
 {
 	int rc, sie_return;
 	struct sie_page *sie_page = (struct sie_page *)vcpu->arch.sie_block;
+	psw_t *gpsw = &vcpu->arch.sie_block->gpsw;
+	bool esa;
 
 	/*
 	 * We try to hold kvm->srcu during most of vcpu_run (except when run-
@@ -4815,10 +4960,23 @@ static int __vcpu_run(struct kvm_vcpu *vcpu)
 		guest_timing_enter_irqoff();
 		__disable_cpu_timer_accounting(vcpu);
 
+		/*
+		 * The state description of a vCPU in the ESA/390-compatibility
+		 * mode holds the eight-byte PSW while the vCPU is in SIE.
+		 */
+		esa = kvm_s390_vcpu_is_esa(vcpu);
+		if (esa) {
+			gpsw->mask = kvm_s390_psw_to_esa(gpsw);
+			gpsw->addr = 0;
+		}
+
 		sie_return = kvm_s390_enter_exit_sie(vcpu->arch.sie_block,
 						     vcpu->run->s.regs.gprs,
 						     vcpu->arch.gmap->asce.val);
 
+		if (esa)
+			kvm_s390_psw_from_esa(gpsw, gpsw->mask);
+
 		__enable_cpu_timer_accounting(vcpu);
 		guest_timing_exit_irqoff();
 		local_irq_enable();
diff --git a/arch/s390/kvm/s390/s390.h b/arch/s390/kvm/s390/s390.h
index 2fb412c1d3f8..5e1b2a1af1ba 100644
--- a/arch/s390/kvm/s390/s390.h
+++ b/arch/s390/kvm/s390/s390.h
@@ -292,6 +292,17 @@ static inline int set_kvm_facility(u64 *fac_list, unsigned long nr)
 	return 0;
 }
 
+static inline int clear_kvm_facility(u64 *fac_list, unsigned long nr)
+{
+	unsigned char *ptr;
+
+	if (nr >= MAX_FACILITY_BIT)
+		return -EINVAL;
+	ptr = (unsigned char *)fac_list + (nr >> 3);
+	*ptr &= ~(0x80UL >> (nr & 7));
+	return 0;
+}
