+/*
+ * Facility bit 2 tells whether the z/Architecture architectural mode is
+ * active. For a VM with KVM_CAP_S390_ESA390_CM, KVM keeps it in line with the
+ * mode in the facility list that the guest and user space see. All other
+ * bits, those of the ESA/390-compatibility-mode facility (168) and of the
+ * configuration-z/Architecture-architectural-mode facility (138) included,
+ * stay as user space set them.
+ */
+static void kvm_s390_update_fac_arch_mode(struct kvm *kvm)
+{
+	if (!kvm->arch.esa390_cm)
+		return;
+	if (kvm->arch.esa390_cm_active)
+		clear_kvm_facility(kvm->arch.model.fac_list, 2);
+	else
+		set_kvm_facility(kvm->arch.model.fac_list, 2);
+}
+
+/*
+ * The flags and execution controls of a state description that depend on the
+ * architectural mode. An ESA/390-format state description has no enhanced
+ * DAT, and the facilities that exist only in the z/Architecture architectural
+ * mode are not enabled in it: transactional execution, vector registers,
+ * guarded storage and runtime instrumentation. The latter two are enabled
+ * again on first use.
+ */
+static void kvm_s390_vcpu_set_arch_mode_controls(struct kvm_vcpu *vcpu)
+{
+	struct kvm_s390_sie_block *scb = vcpu->arch.sie_block;
+
+	kvm_s390_clear_cpuflags(vcpu, CPUSTAT_ZARCH | CPUSTAT_GED | CPUSTAT_GED2);
+	scb->ecb &= ~(ECB_TE | ECB_GS);
+	scb->ecb3 &= ~ECB3_RI;
+	scb->eca &= ~ECA_VX;
+	scb->ecd &= ~ECD_HOSTREGMGMT;
+	if (kvm_s390_vcpu_is_esa(vcpu))
+		return;
+
+	kvm_s390_set_cpuflags(vcpu, CPUSTAT_ZARCH);
+	if (test_kvm_facility(vcpu->kvm, 78))
+		kvm_s390_set_cpuflags(vcpu, CPUSTAT_GED2);
+	else if (test_kvm_facility(vcpu->kvm, 8))
+		kvm_s390_set_cpuflags(vcpu, CPUSTAT_GED);
+	if (test_kvm_facility(vcpu->kvm, 73))
+		scb->ecb |= ECB_TE;
+	if (test_kvm_facility(vcpu->kvm, 129)) {
+		scb->eca |= ECA_VX;
+		scb->ecd |= ECD_HOSTREGMGMT;
+	}
+}
+
+/*
+ * Put all vCPUs into the ESA/390-compatibility mode or into the z/Architecture
+ * architectural mode. Only the format of the state descriptions changes; the
+ * register contents the mode change defines (PSW, control registers, prefix)
+ * are the business of user space, except that the prefix is aligned to the
+ * prefix area of the new mode.
+ */
+static int kvm_s390_set_arch_mode(struct kvm *kvm, bool esa)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long i;
+	int rc;
+
+	lockdep_assert_held(&kvm->lock);
+
+	if (kvm->arch.esa390_cm_active == esa)
+		return 0;
+	/* no vCPU may be running or be in the middle of an interception */
+	rc = kvm_trylock_all_vcpus(kvm);
+	if (rc)
+		return rc;
+	/* guest debugging is not supported in the mode */
+	if (esa) {
+		kvm_for_each_vcpu(i, vcpu, kvm) {
+			if (guestdbg_enabled(vcpu)) {
+				kvm_unlock_all_vcpus(kvm);
+				return -EINVAL;
+			}
+		}
+	}
+	kvm->arch.esa390_cm_active = esa;
+	kvm_for_each_vcpu(i, vcpu, kvm) {
+		kvm_s390_vcpu_set_arch_mode_controls(vcpu);
+		kvm_s390_set_prefix(vcpu, kvm_s390_get_prefix(vcpu));
+	}
+	kvm_s390_update_fac_arch_mode(kvm);
+	kvm_unlock_all_vcpus(kvm);
+	VM_EVENT(kvm, 3, "architectural mode: %s", esa ? "ESA/390-CM" : "z/Architecture");
+	return 0;
+}
+
+static int kvm_s390_vm_set_arch_mode(struct kvm *kvm, struct kvm_device_attr *attr)
+{
+	u32 mode;
+
+	if (!kvm->arch.esa390_cm || attr->attr != KVM_S390_VM_ARCH_MODE_CURRENT)
+		return -ENXIO;
+	if (get_user(mode, (u32 __user *)attr->addr))
+		return -EFAULT;
+	if (mode != KVM_S390_ARCH_MODE_ZARCH && mode != KVM_S390_ARCH_MODE_ESA390_CM)
+		return -EINVAL;
+
+	guard(mutex)(&kvm->lock);
+	return kvm_s390_set_arch_mode(kvm, mode == KVM_S390_ARCH_MODE_ESA390_CM);
+}
+
+static int kvm_s390_vm_get_arch_mode(struct kvm *kvm, struct kvm_device_attr *attr)
+{
+	u32 mode = KVM_S390_ARCH_MODE_ZARCH;
+
+	if (!kvm->arch.esa390_cm || attr->attr != KVM_S390_VM_ARCH_MODE_CURRENT)
+		return -ENXIO;
+	if (READ_ONCE(kvm->arch.esa390_cm_active))
+		mode = KVM_S390_ARCH_MODE_ESA390_CM;
+	return put_user(mode, (u32 __user *)attr->addr) ? -EFAULT : 0;
+}
+
 static int kvm_s390_set_processor(struct kvm *kvm, struct kvm_device_attr *attr)
 {
 	struct kvm_s390_vm_cpu_processor *proc;
@@ -1501,6 +1644,7 @@ static int kvm_s390_set_processor(struct kvm *kvm, struct kvm_device_attr *attr)
 		}
 		memcpy(kvm->arch.model.fac_list, proc->fac_list,
 		       S390_ARCH_FAC_LIST_SIZE_BYTE);
+		kvm_s390_update_fac_arch_mode(kvm);
 		VM_EVENT(kvm, 3, "SET: guest ibc: 0x%4.4x, guest cpuid: 0x%16.16llx",
 			 kvm->arch.model.ibc,
 			 kvm->arch.model.cpuid);
@@ -2038,6 +2182,9 @@ static int kvm_s390_vm_set_attr(struct kvm *kvm, struct kvm_device_attr *attr)
 	case KVM_S390_VM_CPU_TOPOLOGY:
