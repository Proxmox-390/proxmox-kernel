From 23ae7324a2dd0bafe74aa4004fbe8c1ce2f0d6d1 Mon Sep 17 00:00:00 2001
From: Yvan Janssens <yvanj@cyber.gent>
Date: Wed, 25 Nov 2026 12:40:13 +0100
Subject: [RFC PATCH 4/7] KVM: s390: Refuse in the mode what exists only in
 z/Architecture

Some things KVM does for a guest are defined for the z/Architecture
architectural mode only. Keep them away from a configuration in the
ESA/390-compatibility mode:

- START INTERPRETIVE EXECUTION: vsie shadows the address space of a guest 2
  that uses z/Architecture dynamic address translation. End the
  instruction with an operation exception.
- The SIGP orders conditional emergency signal and sense running status
  exist only in z/Architecture (Principles of Operation, "Signal-Processor
  Orders": orders that are unique to z/Architecture are invalid in the
  mode). They are the two such orders KVM executes itself even when user
  space handles SIGP; store "invalid order".
- Runtime instrumentation and guarded storage are not enabled on first use
  or on behalf of user space.
- KVM_S390_STORE_STATUS would store the z/Architecture save areas: return
  -EINVAL.
- A protected VM is always in z/Architecture mode: KVM_PV_ENABLE fails for
  a VM that can be in the mode.
- Guest debugging (KVM_SET_GUEST_DEBUG) uses PER with the z/Architecture
  formats of the state description and of the PER fields in the prefix
  area. Enabling it fails with -EINVAL for a vCPU in the mode; disabling
  it still works.

No functional change as long as no vCPU is in the mode.

Assisted-by: Claude:claude-fable-5-2
Assisted-by: Claude:claude-opus-5-5
---
 arch/s390/kvm/s390/priv.c |  4 ++--
 arch/s390/kvm/s390/s390.c | 17 +++++++++++++++++
 arch/s390/kvm/s390/sigp.c | 17 +++++++++++++++++
 arch/s390/kvm/s390/vsie.c |  7 +++++++
 4 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/arch/s390/kvm/s390/priv.c b/arch/s390/kvm/s390/priv.c
index 5b827c2f9a60..9f068529db0f 100644
--- a/arch/s390/kvm/s390/priv.c
+++ b/arch/s390/kvm/s390/priv.c
@@ -34,7 +34,7 @@ static int handle_ri(struct kvm_vcpu *vcpu)
 {
 	vcpu->stat.instruction_ri++;
 
-	if (test_kvm_facility(vcpu->kvm, 64)) {
+	if (test_kvm_facility(vcpu->kvm, 64) && !kvm_s390_vcpu_is_esa(vcpu)) {
 		VCPU_EVENT(vcpu, 3, "%s", "ENABLE: RI (lazy)");
 		vcpu->arch.sie_block->ecb3 |= ECB3_RI;
 		kvm_s390_retry_instr(vcpu);
@@ -55,7 +55,7 @@ static int handle_gs(struct kvm_vcpu *vcpu)
 {
 	vcpu->stat.instruction_gs++;
 
-	if (test_kvm_facility(vcpu->kvm, 133)) {
+	if (test_kvm_facility(vcpu->kvm, 133) && !kvm_s390_vcpu_is_esa(vcpu)) {
 		VCPU_EVENT(vcpu, 3, "%s", "ENABLE: GS (lazy)");
 		preempt_disable();
 		local_ctl_set_bit(2, CR2_GUARDED_STORAGE_BIT);
diff --git a/arch/s390/kvm/s390/s390.c b/arch/s390/kvm/s390/s390.c
index 06e016f83eaa..a5bea475fbd3 100644
--- a/arch/s390/kvm/s390/s390.c
+++ b/arch/s390/kvm/s390/s390.c
@@ -2566,6 +2566,9 @@ static int kvm_s390_handle_pv(struct kvm *kvm, struct kvm_pv_cmd *cmd)
 		r = -EINVAL;
 		if (kvm_s390_pv_is_protected(kvm))
 			break;
+		/* a protected configuration is always in z/Architecture mode */
+		if (kvm->arch.esa390_cm)
+			break;
 
 		kvm_s390_unmap_all_adapters(kvm);
 		mmap_write_lock(kvm->mm);
@@ -4214,6 +4217,14 @@ int kvm_arch_vcpu_ioctl_set_guest_debug(struct kvm_vcpu *vcpu,
 		rc = -EINVAL;
 		goto out;
 	}
+	/*
+	 * Guest debugging works with PER in the z/Architecture formats of the
+	 * state description and of the assigned storage locations only.
+	 */
+	if ((dbg->control & KVM_GUESTDBG_ENABLE) && kvm_s390_vcpu_is_esa(vcpu)) {
+		rc = -EINVAL;
+		goto out;
+	}
 
 	if (dbg->control & KVM_GUESTDBG_ENABLE) {
 		vcpu->guest_debug = dbg->control;
@@ -4872,6 +4883,7 @@ static void sync_regs_fmt2(struct kvm_vcpu *vcpu)
 	 */
 	if ((kvm_run->kvm_dirty_regs & KVM_SYNC_RICCB) &&
 	    test_kvm_facility(vcpu->kvm, 64) &&
+	    !kvm_s390_vcpu_is_esa(vcpu) &&
 	    riccb->v &&
 	    !(vcpu->arch.sie_block->ecb3 & ECB3_RI)) {
 		VCPU_EVENT(vcpu, 3, "%s", "ENABLE: RI (sync_regs)");
@@ -4883,6 +4895,7 @@ static void sync_regs_fmt2(struct kvm_vcpu *vcpu)
 	 */
 	if ((kvm_run->kvm_dirty_regs & KVM_SYNC_GSCB) &&
 	    test_kvm_facility(vcpu->kvm, 133) &&
+	    !kvm_s390_vcpu_is_esa(vcpu) &&
 	    gscb->gssm &&
 	    !vcpu->arch.gs_enabled) {
 		VCPU_EVENT(vcpu, 3, "%s", "ENABLE: GS (sync_regs)");
@@ -5521,6 +5534,10 @@ long kvm_arch_vcpu_ioctl(struct file *filp,
 
 	switch (ioctl) {
 	case KVM_S390_STORE_STATUS:
+		/* only the z/Architecture format of the save areas is provided */
+		r = -EINVAL;
+		if (kvm_s390_vcpu_is_esa(vcpu))
+			break;
 		idx = srcu_read_lock(&vcpu->kvm->srcu);
 		r = kvm_s390_store_status_unloaded(vcpu, arg);
 		srcu_read_unlock(&vcpu->kvm->srcu, idx);
diff --git a/arch/s390/kvm/s390/sigp.c b/arch/s390/kvm/s390/sigp.c
index 131b3371ef4f..4a83ef261f94 100644
--- a/arch/s390/kvm/s390/sigp.c
+++ b/arch/s390/kvm/s390/sigp.c
@@ -422,6 +422,17 @@ static int handle_sigp_order_in_user_space(struct kvm_vcpu *vcpu, u8 order_code,
 	return 1;
 }
 
+/*
+ * Orders that exist only in the z/Architecture architectural mode and that
+ * KVM executes itself even if user space handles SIGP. They are invalid
+ * orders for a CPU in the ESA/390-compatibility mode.
+ */
+static bool sigp_order_is_zarch_only(u8 order_code)
+{
+	return order_code == SIGP_COND_EMERGENCY_SIGNAL ||
+	       order_code == SIGP_SENSE_RUNNING;
+}
+
 int kvm_s390_handle_sigp(struct kvm_vcpu *vcpu)
 {
 	int r1 = (vcpu->arch.sie_block->ipa & 0x00f0) >> 4;
@@ -436,6 +447,12 @@ int kvm_s390_handle_sigp(struct kvm_vcpu *vcpu)
 		return kvm_s390_inject_program_int(vcpu, PGM_PRIVILEGED_OP);
 
 	order_code = kvm_s390_get_base_disp_rs(vcpu, NULL);
+	if (kvm_s390_vcpu_is_esa(vcpu) && sigp_order_is_zarch_only(order_code)) {
+		vcpu->run->s.regs.gprs[r1] &= 0xffffffff00000000UL;
+		vcpu->run->s.regs.gprs[r1] |= SIGP_STATUS_INVALID_ORDER;
+		kvm_s390_set_psw_cc(vcpu, SIGP_CC_STATUS_STORED);
+		return 0;
+	}
 	if (handle_sigp_order_in_user_space(vcpu, order_code, cpu_addr))
 		return -EOPNOTSUPP;
 
diff --git a/arch/s390/kvm/s390/vsie.c b/arch/s390/kvm/s390/vsie.c
index 5926689fa226..bc086096d778 100644
--- a/arch/s390/kvm/s390/vsie.c
+++ b/arch/s390/kvm/s390/vsie.c
@@ -1564,6 +1564,13 @@ int kvm_s390_handle_vsie(struct kvm_vcpu *vcpu)
 		return -EOPNOTSUPP;
 	if (vcpu->arch.sie_block->gpsw.mask & PSW_MASK_PSTATE)
 		return kvm_s390_inject_program_int(vcpu, PGM_PRIVILEGED_OP);
+	/*
+	 * vsie shadows the address space of a z/Architecture guest 2. A guest
+	 * in the ESA/390-compatibility mode has no dynamic address translation
+	 * and cannot start interpretive execution.
+	 */
+	if (kvm_s390_vcpu_is_esa(vcpu))
+		return kvm_s390_inject_program_int(vcpu, PGM_OPERATION);
 
 	scb_addr = kvm_s390_get_base_disp_s(vcpu, NULL);
 
-- 
2.47.3

