+/*
+ * Validity of a PSW (in the 16-byte format) for the mode the vCPU is in.
+ * The ESA/390-compatibility mode knows neither dynamic address translation
+ * nor the 64-bit addressing mode.
+ */
+int kvm_s390_is_valid_psw(struct kvm_vcpu *vcpu, psw_t *psw)
+{
+	if (kvm_s390_vcpu_is_esa(vcpu) &&
+	    (psw->mask & (PSW_MASK_DAT | PSW_MASK_EA)))
+		return 0;
+	return is_valid_psw(psw);
