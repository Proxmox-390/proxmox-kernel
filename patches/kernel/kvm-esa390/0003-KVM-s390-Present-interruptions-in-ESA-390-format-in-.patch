 	return rc ? -EFAULT : 0;
@@ -511,14 +606,58 @@ static int __must_check __deliver_pfault_init(struct kvm_vcpu *vcpu)
 
 	rc  = put_guest_lc(vcpu, EXT_IRQ_CP_SERVICE, (u16 *) __LC_EXT_INT_CODE);
 	rc |= put_guest_lc(vcpu, PFAULT_INIT, (u16 *) __LC_EXT_CPU_ADDR);
-	rc |= write_guest_lc(vcpu, __LC_EXT_OLD_PSW,
-			     &vcpu->arch.sie_block->gpsw, sizeof(psw_t));
-	rc |= read_guest_lc(vcpu, __LC_EXT_NEW_PSW,
-			    &vcpu->arch.sie_block->gpsw, sizeof(psw_t));
+	rc |= kvm_s390_lc_store_old_psw(vcpu, __LC_EXT_OLD_PSW);
+	rc |= kvm_s390_lc_load_new_psw(vcpu, __LC_EXT_NEW_PSW);
 	rc |= put_guest_lc(vcpu, ext.ext_params2, (u64 *) __LC_EXT_PARAMS2);
 	return rc ? -EFAULT : 0;
 }
 
+/*
+ * Machine-check interruption in the ESA/390-compatibility mode: the save
+ * areas lie in the first 512 bytes and hold the 32-bit registers. The
+ * extended save area (floating-point registers 0-15) is not stored.
+ */
+static int __write_machine_check_esa(struct kvm_vcpu *vcpu,
+				     struct kvm_s390_mchk_info *mchk,
+				     union mci mci)
+{
+	freg_t fprs[NUM_FPRS];
+	u32 regs[16];
+	int rc, i;
+
+	mci.vr = 0;
+	mci.gs = 0;
+	rc = put_guest_lc(vcpu, 0, (u8 __user *)__LC_AR_MODE_ID);
+	rc |= kvm_s390_lc_store_old_psw(vcpu, __LC_MCK_OLD_PSW);
+	rc |= kvm_s390_lc_load_new_psw(vcpu, __LC_MCK_NEW_PSW);
+	rc |= put_guest_lc(vcpu, mci.val, (u64 __user *)__LC_MCCK_CODE);
+
+	rc |= put_guest_lc(vcpu, kvm_s390_get_cpu_timer(vcpu),
+			   (u64 __user *)ESA_LC_CPU_TIMER_SAVE_AREA);
+	rc |= put_guest_lc(vcpu, vcpu->arch.sie_block->ckc,
+			   (u64 __user *)ESA_LC_CLOCK_COMP_SAVE_AREA);
+	rc |= put_guest_lc(vcpu, mchk->ext_damage_code,
+			   (u32 __user *)ESA_LC_EXT_DAMAGE_CODE);
+	rc |= put_guest_lc(vcpu, (u32)mchk->failing_storage_address,
+			   (u32 __user *)ESA_LC_MCCK_FAIL_STOR_ADDR);
+	rc |= write_guest_lc(vcpu, ESA_LC_AREGS_SAVE_AREA,
+			     &vcpu->run->s.regs.acrs, 64);
+	if (cpu_has_vx())
+		convert_vx_to_fp(fprs, (__vector128 *)vcpu->run->s.regs.vrs);
+	else
+		memcpy(fprs, vcpu->run->s.regs.fprs, sizeof(fprs));
+	for (i = 0; i < 4; i++)
+		rc |= write_guest_lc(vcpu, ESA_LC_FPREGS_SAVE_AREA + 8 * i,
+				     &fprs[2 * i], 8);
+	for (i = 0; i < 16; i++)
+		regs[i] = (u32)vcpu->run->s.regs.gprs[i];
+	rc |= write_guest_lc(vcpu, ESA_LC_GPREGS_SAVE_AREA, regs, 64);
+	for (i = 0; i < 16; i++)
+		regs[i] = (u32)vcpu->arch.sie_block->gcr[i];
+	rc |= write_guest_lc(vcpu, ESA_LC_CREGS_SAVE_AREA, regs, 64);
+	return rc ? -EFAULT : 0;
+}
+
