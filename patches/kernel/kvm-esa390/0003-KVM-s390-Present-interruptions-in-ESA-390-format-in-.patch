+/*
+ * Low storage of a CPU in the ESA/390-compatibility mode, where it differs
+ * from z/Architecture: the assigned storage locations of ESA/390. The old
+ * and new PSWs are eight bytes long, the register save areas lie in the
+ * first 512 bytes and hold 32-bit general and control registers.
+ */
+#define ESA_LC_RST_NEW_PSW		0
+#define ESA_LC_RST_OLD_PSW		8
+#define ESA_LC_EXT_OLD_PSW		24
+#define ESA_LC_SVC_OLD_PSW		32
+#define ESA_LC_PGM_OLD_PSW		40
+#define ESA_LC_MCK_OLD_PSW		48
+#define ESA_LC_IO_OLD_PSW		56
+#define ESA_LC_EXT_NEW_PSW		88
+#define ESA_LC_SVC_NEW_PSW		96
+#define ESA_LC_PGM_NEW_PSW		104
+#define ESA_LC_MCK_NEW_PSW		112
+#define ESA_LC_IO_NEW_PSW		120
+#define ESA_LC_PGM_EXC_ID		144
+#define ESA_LC_PER_ADDRESS		152
+#define ESA_LC_MON_CODE			156
+#define ESA_LC_CPU_TIMER_SAVE_AREA	216
+#define ESA_LC_CLOCK_COMP_SAVE_AREA	224
+#define ESA_LC_EXT_DAMAGE_CODE		244
+#define ESA_LC_MCCK_FAIL_STOR_ADDR	248
+#define ESA_LC_AREGS_SAVE_AREA		288
+#define ESA_LC_FPREGS_SAVE_AREA		352
+#define ESA_LC_GPREGS_SAVE_AREA		384
+#define ESA_LC_CREGS_SAVE_AREA		448
+
+/*
+ * The callers name the z/Architecture location of an old or new PSW; map it
+ * to the location the PSW has in the ESA/390-compatibility mode.
+ */
+static unsigned long lc_esa_psw_addr(unsigned long lc_addr)
+{
+	switch (lc_addr) {
+	case __LC_RST_NEW_PSW:
+		return ESA_LC_RST_NEW_PSW;
+	case __LC_RST_OLD_PSW:
+		return ESA_LC_RST_OLD_PSW;
+	case __LC_EXT_OLD_PSW:
+		return ESA_LC_EXT_OLD_PSW;
+	case __LC_SVC_OLD_PSW:
+		return ESA_LC_SVC_OLD_PSW;
+	case __LC_PGM_OLD_PSW:
+		return ESA_LC_PGM_OLD_PSW;
+	case __LC_MCK_OLD_PSW:
+		return ESA_LC_MCK_OLD_PSW;
+	case __LC_IO_OLD_PSW:
+		return ESA_LC_IO_OLD_PSW;
+	case __LC_EXT_NEW_PSW:
+		return ESA_LC_EXT_NEW_PSW;
+	case __LC_SVC_NEW_PSW:
+		return ESA_LC_SVC_NEW_PSW;
+	case __LC_PGM_NEW_PSW:
+		return ESA_LC_PGM_NEW_PSW;
+	case __LC_MCK_NEW_PSW:
+		return ESA_LC_MCK_NEW_PSW;
+	case __LC_IO_NEW_PSW:
+		return ESA_LC_IO_NEW_PSW;
+	}
+	WARN_ON_ONCE(1);
+	return lc_addr;
+}
+
+int kvm_s390_lc_store_old_psw(struct kvm_vcpu *vcpu, unsigned long lc_addr)
+{
+	u64 esa;
+
+	if (!kvm_s390_vcpu_is_esa(vcpu))
+		return write_guest_lc(vcpu, lc_addr,
+				      &vcpu->arch.sie_block->gpsw,
+				      sizeof(psw_t));
+	esa = kvm_s390_psw_to_esa(&vcpu->arch.sie_block->gpsw);
+	return write_guest_lc(vcpu, lc_esa_psw_addr(lc_addr), &esa,
+			      sizeof(esa));
+}
+
+int kvm_s390_lc_read_new_psw(struct kvm_vcpu *vcpu, unsigned long lc_addr,
+			     psw_t *psw)
+{
+	u64 esa;
+	int rc;
+
+	if (!kvm_s390_vcpu_is_esa(vcpu))
+		return read_guest_lc(vcpu, lc_addr, psw, sizeof(psw_t));
+	rc = read_guest_lc(vcpu, lc_esa_psw_addr(lc_addr), &esa, sizeof(esa));
+	if (!rc)
+		kvm_s390_psw_from_esa(psw, esa);
+	return rc;
+}
+
+int kvm_s390_lc_load_new_psw(struct kvm_vcpu *vcpu, unsigned long lc_addr)
+{
+	return kvm_s390_lc_read_new_psw(vcpu, lc_addr,
+					&vcpu->arch.sie_block->gpsw);
+}
