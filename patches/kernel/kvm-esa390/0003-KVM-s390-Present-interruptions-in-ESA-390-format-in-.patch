+/*
+ * Program interruption in the ESA/390-compatibility mode. Dynamic address
+ * translation and access-register translation do not exist in the mode, so
+ * only the exceptions that can occur with DAT off need their information:
+ * low storage has the ESA/390 layout (four-byte PER address, monitor code
+ * and protection-exception identification; no breaking-event address).
+ */
+static int __must_check __deliver_prog_esa(struct kvm_vcpu *vcpu,
+					   struct kvm_s390_pgm_info *pgm_info)
+{
+	u16 ilen = pgm_info->flags & KVM_S390_PGM_FLAGS_ILC_MASK;
+	bool nullifying = false;
+	int rc = 0;
+
+	switch (pgm_info->code & ~PGM_PER) {
+	case PGM_MONITOR:
+		rc = put_guest_lc(vcpu, pgm_info->mon_class_nr,
+				  (u16 *)__LC_MON_CLASS_NR);
+		rc |= put_guest_lc(vcpu, (u32)pgm_info->mon_code,
+				   (u32 *)ESA_LC_MON_CODE);
+		break;
+	case PGM_DATA:
+		rc = put_guest_lc(vcpu, pgm_info->data_exc_code,
+				  (u32 *)ESA_LC_PGM_EXC_ID);
+		break;
+	case PGM_PROTECTION:
+		rc = put_guest_lc(vcpu, (u32)pgm_info->trans_exc_code,
+				  (u32 *)ESA_LC_PGM_EXC_ID);
+		rc |= put_guest_lc(vcpu, pgm_info->exc_access_id,
+				   (u8 *)__LC_EXC_ACCESS_ID);
+		break;
+	case PGM_STACK_FULL:
+	case PGM_STACK_EMPTY:
+	case PGM_STACK_SPECIFICATION:
+	case PGM_STACK_TYPE:
+	case PGM_STACK_OPERATION:
+	case PGM_TRACE_TABEL:
+	case PGM_CRYPTO_OPERATION:
+		nullifying = true;
+		break;
+	}
+
+	if (pgm_info->code & PGM_PER) {
+		rc |= put_guest_lc(vcpu, pgm_info->per_code,
+				   (u8 *)__LC_PER_CODE);
+		rc |= put_guest_lc(vcpu, pgm_info->per_atmid,
+				   (u8 *)__LC_PER_ATMID);
+		rc |= put_guest_lc(vcpu, (u32)pgm_info->per_address,
+				   (u32 *)ESA_LC_PER_ADDRESS);
+		rc |= put_guest_lc(vcpu, pgm_info->per_access_id,
+				   (u8 *)__LC_PER_ACCESS_ID);
+	}
+
+	if (nullifying && !(pgm_info->flags & KVM_S390_PGM_FLAGS_NO_REWIND))
+		kvm_s390_rewind_psw(vcpu, ilen);
+
+	rc |= put_guest_lc(vcpu, ilen, (u16 *)__LC_PGM_ILC);
+	rc |= put_guest_lc(vcpu, pgm_info->code, (u16 *)__LC_PGM_CODE);
+	rc |= kvm_s390_lc_store_old_psw(vcpu, __LC_PGM_OLD_PSW);
+	rc |= kvm_s390_lc_load_new_psw(vcpu, __LC_PGM_NEW_PSW);
+	return rc ? -EFAULT : 0;
+}
+
